+                id.key(),
+                &fences,
+                "rng-seed",
+            )
+        }
+        .map_err(MetalError::from)?;
+        let seed = Arc::new(Mutex::new(seed_buffer));
+        Ok(Self {
+            id,
+            device,
+            commands: Arc::new(RwLock::new(commands)),
+            fences,
+            kernels,
+            seed,
+            seed_value: Arc::new(RwLock::new(299792458)),
+        })
+    }
