+
+/// Lets a host watch command-buffer traffic; every method defaulted, so no observer costs one load per commit.
+pub trait CommandBufferObserver: Send + Sync {
+    fn note_commit(&self) {}
+    /// A compute encoder opened on a pool buffer.
+    fn note_encoder(&self) {}
+    fn note_pipeline(&self, _name: &Arc<str>) {}
+    fn note_resource(&self, _ptr: usize) {}
+    fn arm_completion(&self) -> Option<u64> {
+        None
+    }
+    fn note_completion(&self, _completion: Completion<'_>) {}
+}
+
+static OBSERVER: OnceLock<Arc<dyn CommandBufferObserver>> = OnceLock::new();
+
+/// Install the process-wide observer. The first call wins.
+pub fn set_command_buffer_observer(observer: Arc<dyn CommandBufferObserver>) {
+    let _ = OBSERVER.set(observer);
+}
+
+#[inline]
+pub(crate) fn observer() -> Option<&'static Arc<dyn CommandBufferObserver>> {
+    OBSERVER.get()
+}
 
