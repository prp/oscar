new file mode 100644
index 00000000..ed92adf0
--- /dev/null
+++ w/candle-metal-kernels/src/metal/pool.rs
@@ -0,0 +1,144 @@
+//! Where every Metal buffer comes from: the host installs one pool ([`set_buffer_pool`]) and
+//! every allocation in this crate and in `candle-core` goes through it, no path to the driver
+//! beside it and no fallback. The pool owns its pages, so a released buffer's memory returns at once.
+
+use super::{Buffer, CommandQueue, Device};
+use crate::MetalKernelError;
+use objc2::rc::Retained;
+use objc2::runtime::ProtocolObject;
+use objc2_metal::{MTLCommandBuffer, MTLSharedEvent};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, OnceLock};
+
+/// What a pooled buffer keeps alive for as long as it exists: the pool's
+/// hold on its pages. The last handle's drop is what gives them back.
+pub trait Held: Send + Sync + std::fmt::Debug {}
+
+/// Which pool a request belongs to: the two differ in whether their memory can ever be given back, what a pool is.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Use {
+    /// Working memory the GPU writes: a run given back inside a forward is cut again at once.
+    Scratch,
+    /// Working memory the CPU writes into at the allocation: a block table, a position row, a
+    /// weight's bytes at load. Its reuse needs a fence, since Metal's hazard tracking says
+    /// nothing about a CPU write into a buffer whose last command buffer is still in flight.
+    Staged,
+    /// The floor: taken once and held for the process's life (the dense weights, the address tables, the mailbox).
+    Fixed,
+}
+
+/// A queue's progress, as a pool reads it: the generation the last commit took, the generation the GPU has
+/// finished, and whether the queue still has work to commit.
+#[derive(Clone)]
+pub struct Fences {
+    committed: Arc<AtomicU64>,
+    completed: Retained<ProtocolObject<dyn MTLSharedEvent>>,
+    inflight: u64,
+    /// The pool entries' encoded-work counts ([`super::Commands::encoded_counts`]).
+    encoded: Arc<Vec<Arc<std::sync::atomic::AtomicUsize>>>,
+}
+
+// SAFETY: an atomic and a Metal event, both safe to read from any thread.
+unsafe impl Send for Fences {}
+unsafe impl Sync for Fences {}
+
+impl Fences {
+    pub fn new(
+        committed: Arc<AtomicU64>,
+        completed: Retained<ProtocolObject<dyn MTLSharedEvent>>,
+        inflight: u64,
+        encoded: Arc<Vec<Arc<std::sync::atomic::AtomicUsize>>>,
+    ) -> Self {
+        Self { committed, completed, inflight, encoded }
+    }
+
+    /// The generation a buffer freed now must wait for: not the committed count, since an open
+    /// command buffer already reading the buffer commits later and any of the other in-flight
+    /// entries may commit first, so the work's generation is up to the pool's depth past it.
+    pub fn fence(&self) -> u64 {
+        self.committed.load(Ordering::SeqCst) + self.inflight
+    }
+
+    /// The generation the GPU has finished.
+    pub fn completed(&self) -> u64 {
+        self.completed.signaledValue()
+    }
+
+    /// The generation the queue has passed, read once for any number of stamps: a buffer freed
+    /// at or below it may be unmapped or written. Either the GPU passed `committed + inflight`,
+    /// or the queue has nothing encoded and finished all it committed, which an idle queue meets.
+    pub fn pass(&self) -> u64 {
+        let completed = self.completed();
+        let encoding = self
+            .encoded
+            .iter()
+            .any(|c| c.load(std::sync::atomic::Ordering::Acquire) > 0);
+        if !encoding && completed >= self.committed.load(Ordering::SeqCst) {
+            u64::MAX
+        } else {
+            completed
+        }
+    }
+
+}
+
+/// Where a thread stream's queue keys begin: a device instance's queue is keyed by its id from 1, a stream's from
+/// here up, so a pool tells the two apart (a device's working memory is the plan's, a stream's sized from its forward).
+pub const STREAM_QUEUE_KEYS: usize = 1 << 32;
+
+/// The one allocator. Sizing and reuse are the pool's business; this crate asks for bytes and which use they are for.
+pub trait BufferPool: Send + Sync {
+    /// A buffer of at least `bytes` for `queue`'s working memory. The key is the queue the buffer
+    /// will be used on: a run is never reused across queues, where Metal's hazard tracking does
+    /// not reach. `name` is the caller's label for the diagnostics, never part of the placement.
+    fn allocate(
+        &self,
+        device: &Device,
+        bytes: usize,
+        r#use: Use,
+        queue: usize,
+        fences: &Fences,
+        name: &'static str,
+    ) -> Result<Buffer, MetalKernelError>;
+
+    /// Put the pool's residency sets on `queue`, whose working region is kept under `key`: the floor's set, which every
+    /// queue reads, and this queue's own region's, never another's (nothing is read there; a queue takes at most 32).
+    fn attach(&self, queue: &CommandQueue, key: usize);
+
+    /// Declare the pools reachable from `queue` on a command buffer just minted from it, so a
+    /// launch may reach one by raw GPU address: attaching a set to a queue only requests
+    /// residency, while a command buffer's own declaration is honoured for its execution.
+    fn declare(&self, command_buffer: &ProtocolObject<dyn MTLCommandBuffer>, queue: &CommandQueue);
+}
+
+/// Encode, never submit: armed while the host runs a forward to record what it asks the pools for, the command buffers
+/// dropped uncommitted. The completion side is then advanced from the CPU ([`super::Commands`]), or every fence waits.
+static CENSUS: AtomicBool = AtomicBool::new(false);
+
+/// Whether command buffers are being encoded and dropped rather than run.
+#[inline]
+pub fn census() -> bool {
+    CENSUS.load(Ordering::Relaxed)
+}
+
+/// Arm or disarm it; the host owns both edges and disarms before the load
+/// ends, so nothing a request runs is ever left unsubmitted.
+pub fn set_census(on: bool) {
+    CENSUS.store(on, Ordering::Relaxed);
+}
+
+static POOL: OnceLock<Arc<dyn BufferPool>> = OnceLock::new();
+
+/// Install the process's buffer pool. The first call wins.
+pub fn set_buffer_pool(pool: Arc<dyn BufferPool>) {
+    let _ = POOL.set(pool);
+}
+
+/// The installed pool. Every allocation goes through it, so its absence is a startup order bug, not a case to handle.
+pub fn buffer_pool() -> Result<&'static Arc<dyn BufferPool>, MetalKernelError> {
+    POOL.get().ok_or_else(|| {
+        MetalKernelError::FailedToCreateResource(
+            "no buffer pool installed — every Metal allocation comes from one".to_string(),
+        )
+    })
+}
