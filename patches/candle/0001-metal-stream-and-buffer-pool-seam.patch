+/// The line of code that built a host tensor, as the label a pool holds: a host fill has no kernel to name it, so
+/// the seam is `#[track_caller]` up from the tensor constructors and the caller's `file:line` is the label. Interned.
+pub(crate) fn site(at: &'static Location<'static>) -> &'static str {
+    static SITES: Mutex<BTreeMap<(&'static str, u32), &'static str>> = Mutex::new(BTreeMap::new());
+    let file = at.file().rsplit('/').next().unwrap_or(at.file());
+    let mut sites = SITES.lock().unwrap_or_else(|e| e.into_inner());
+    *sites
+        .entry((file, at.line()))
+        .or_insert_with(|| Box::leak(format!("{file}:{}", at.line()).into_boxed_str()))
+}
 
