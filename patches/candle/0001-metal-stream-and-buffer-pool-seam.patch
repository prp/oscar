diff --git c/candle-core/src/metal_backend/thread_stream.rs w/candle-core/src/metal_backend/thread_stream.rs
new file mode 100644
index 00000000..2d710143
--- /dev/null
+++ w/candle-core/src/metal_backend/thread_stream.rs
@@ -0,0 +1,63 @@
+//! Per-thread Metal streams, kept out of `device.rs` so the file candle maintains does not carry them.
+
+use std::cell::RefCell;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, RwLock};
+
+use candle_metal_kernels::metal::{Commands, Fences, STREAM_QUEUE_KEYS};
+
+use crate::Result;
+
+use super::device::MetalDevice;
+use super::MetalError;
+
+/// Queue keys for the streams, from where the pool says a stream's begin, so no stream's key is a device's.
+pub(super) static NEXT_QUEUE: AtomicUsize = AtomicUsize::new(STREAM_QUEUE_KEYS);
+
+/// A private queue and CB pool, so a background thread submits GPU work without perturbing the main thread's ordering.
+/// Its buffers are cut from a working region of the stream's own, so one is never reused on the other's queue.
+pub struct ThreadStream {
+    pub(super) commands: Arc<RwLock<Commands>>,
+    /// The key its working region is kept under: its own queue.
+    pub(super) queue_key: usize,
+    /// Its own queue's progress, for the pool's staged-reuse fence.
+    pub(super) fences: Fences,
+}
+
+thread_local! {
+    /// Installed private stream for this thread; `None` = shared pool (default).
+    static THREAD_STREAM: RefCell<Option<Arc<ThreadStream>>> = const { RefCell::new(None) };
+}
+
+pub(super) fn thread_stream() -> Option<Arc<ThreadStream>> {
+    THREAD_STREAM.with(|cell| cell.borrow().as_ref().map(Arc::clone))
+}
+
+impl MetalDevice {
+    /// Give this thread its own stream, at the start of a long-lived worker, so its Metal work stops sharing the main
+    /// thread's; a thread that has one keeps it. `compute_per_buffer` is the stream's encoders a command buffer, `None`
+    /// the default.
+    pub fn install_thread_stream(&self, compute_per_buffer: Option<usize>) -> Result<()> {
+        if thread_stream().is_some() {
+            return Ok(());
+        }
+        let queue = self.device.new_command_queue().map_err(MetalError::from)?;
+        let key = NEXT_QUEUE.fetch_add(1, Ordering::Relaxed);
+        let commands = Commands::new(queue, key, compute_per_buffer).map_err(MetalError::from)?;
+        // Its own queue means its own working region from here on: a run is never reused across queues,
+        // where Metal's hazard tracking does not reach.
+        let fences = Fences::new(
+            commands.completion_counter(),
+            commands.completion_event(),
+            commands.inflight_bound(),
+            commands.encoded_counts(),
+        );
+        let stream = Arc::new(ThreadStream {
+            commands: Arc::new(RwLock::new(commands)),
+            queue_key: key,
+            fences,
+        });
+        THREAD_STREAM.with(|cell| *cell.borrow_mut() = Some(stream));
+        Ok(())
+    }
+}
