+/// What a completed command buffer reported: times in the host clock Metal stamps, `error` only for a failed buffer.
+pub struct Completion<'a> {
+    pub token: u64,
+    pub gpu_start: f64,
+    pub gpu_end: f64,
+    pub kernel_start: f64,
+    pub error: Option<&'a str>,
