+#[allow(clippy::too_many_arguments)]
+fn call_unary_strided_v2(
+    device: &Device,
+    ep: impl EncoderProvider,
+    kernels: &Kernels,
+    name: strided::Kernel,
+    shape: &[usize],
+    input: BufferOffset,
+    strides: &[usize],
+    output: BufferOffset,
+) -> Result<(), MetalKernelError> {
+    let n = shape.len();
+    let v2_name = format!("{}_v2_n{}", name.0, n);
+    let pipeline = kernels.load_pipeline(device, Source::Unary, v2_name)?;
+
+    let encoder = ep.encoder();
+    let encoder: &ComputeCommandEncoder = encoder.as_ref();
+    encoder.set_compute_pipeline_state(&pipeline);
+
+    let dims_u32: Vec<u32> = shape.iter().map(|&x| x as u32).collect();
+    let src_strides_u64: Vec<u64> = strides.iter().map(|&x| x as u64).collect();
+    let dst_strides_u64 = row_major_strides_u64(shape);
+    set_params!(
+        encoder,
+        (
+            &dims_u32[..],
+            &src_strides_u64[..],
+            &dst_strides_u64[..],
+            &input,
+            &output
+        )
+    );
+    let (grid, group) = strided_v2_grid(shape);
+    encoder.use_resource(input.buffer, MTLResourceUsage::Read);
+    encoder.use_resource(output.buffer, MTLResourceUsage::Write);
+    encoder.dispatch_threads(grid, group);
+    Ok(())
+}
+
+pub(crate) fn row_major_strides_u64(shape: &[usize]) -> Vec<u64> {
+    let n = shape.len();
+    let mut strides = vec![0u64; n];
+    let mut p: u64 = 1;
+    for i in (0..n).rev() {
+        strides[i] = p;
+        p *= shape[i] as u64;
+    }
+    strides
+}
+
+/// Thread.x along last dim (coalesced when stride[N-1]==1); group (32,8,1) = one simdgroup/row.
+pub(crate) fn strided_v2_grid(shape: &[usize]) -> (objc2_metal::MTLSize, objc2_metal::MTLSize) {
+    use objc2_metal::MTLSize;
+    let n = shape.len();
+    let grid = match n {
+        2 => MTLSize {
+            width: shape[1],
+            height: shape[0],
+            depth: 1,
+        },
+        3 => MTLSize {
+            width: shape[2],
+            height: shape[1],
+            depth: shape[0],
+        },
+        4 => MTLSize {
+            width: shape[3],
+            height: shape[2],
+            depth: shape[0] * shape[1],
+        },
+        _ => unreachable!("strided_v2_grid only valid for 2..=4 dims"),
+    };
+    let group = MTLSize {
+        width: 32.min(grid.width).max(1),
+        height: 8.min(grid.height).max(1),
+        depth: 1,
+    };
+    (grid, group)
+}
