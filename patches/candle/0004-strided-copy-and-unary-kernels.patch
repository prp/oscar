+// One thread's element offset on the rank-N 3D grid: tid.x and tid.y the two
+// innermost dims, tid.z the outer ones packed row-major.
+template <uint N>
+METAL_FUNC ulong strided_v2_index(uint3 tid, constant uint *dims, constant ulong *strides) {
+    ulong idx = (ulong)tid.x * strides[N - 1] + (ulong)tid.y * strides[N - 2];
+    if (N == 3) {
+        idx += (ulong)tid.z * strides[0];
+    } else if (N == 4) {
+        idx += (ulong)(tid.z / dims[1]) * strides[0] + (ulong)(tid.z % dims[1]) * strides[1];
+    }
+    return idx;
+}
+
+// Rank-templated 3D-grid variant: thread coordinates map straight onto tensor dims.
+template <typename T, typename U, uint N, typename IR = T>
+[[kernel]] void cast_kernel_strided_v2(
+    constant uint *dims,         // [N]
+    constant ulong *src_strides, // [N], element strides in source
+    constant ulong *dst_strides, // [N], element strides in (row-major) dest
+    constant const T *input,
+    device U *output,
+    uint3 tid [[thread_position_in_grid]]
+) {
+    output[strided_v2_index<N>(tid, dims, dst_strides)] =
+        static_cast<U>(static_cast<IR>(input[strided_v2_index<N>(tid, dims, src_strides)]));
+}
