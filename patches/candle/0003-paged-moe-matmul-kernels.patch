+#ifdef GGML_METAL_HAS_TENSOR
+// The tensor-op GEMM in MLX's qmm_t_nax structure (b6368984, quantized_nax.h): a 64 x 64 tile
+// per threadgroup of four simdgroups, a K step of 64, the weight tile dequantised into
+// threadgroup memory, half activations (cast by the host) in 16 x 16 fragments, f32 accumulation.
+
+#define NAX_MM_BM 64   // tokens per threadgroup
+#define NAX_MM_BN 64   // weight rows per threadgroup
+#define NAX_MM_BK 64   // K per threadgroup step
+#define NAX_MM_BK_PADDED (NAX_MM_BK + 8)
+#define NAX_MM_WS_BYTES (NAX_MM_BN * NAX_MM_BK_PADDED * 2)
+
+// A thread's four rows of the tile: the activation row (half), the output row and whether the row is stored
+// (rows past the tile's count are clamped to the last valid one for the loads and never stored).
+struct mul_mm_nax_rows {
+    device const half * y[4];
+    device float * d[4];
+    bool valid[4];
+};
+
+// Four output floats to a row, the weight-row tail masked per element.
+METAL_FUNC void mul_mm_nax_store4(device float * drow, bool valid, short col, short n_rows, float4 v) {
+    if (!valid) return;
+    if (col + 4 <= n_rows) {
+        *(device float4 *)(drow + col) = v;
+    } else {
+        if (col < n_rows) drow[col] = v.x;
+        if (col + 1 < n_rows) drow[col + 1] = v.y;
+        if (col + 2 < n_rows) drow[col + 2] = v.z;
+        if (col + 3 < n_rows) drow[col + 3] = v.w;
+    }
+}
+
+template<typename T, typename T4x4, typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread T4x4 &)>
+METAL_FUNC void mul_mm_nax_body(
+        device const   uchar * w0,        // the weight rows this tile starts at
+                    uint64_t   nb01,      // the weight row stride in bytes
+                     int64_t   ne00,      // K
+                       short   n_rows,    // weight rows in this tile (≤ 64)
+        thread const mul_mm_nax_rows & rows,
+        threadgroup    uchar * shared_memory,
+                        uint   tiitg,
+                        uint   sgitg) {
+    using namespace nax;
+    threadgroup T * Ws = (threadgroup T *)(shared_memory);
+
+    constexpr short SM = NAX_MM_BM / 2, SN = NAX_MM_BN / 2, SK = 32;
+    constexpr short TM = SM / 16, TN = SN / 16, TK = SK / 16;
+
+    const short tn = SN * (short)(sgitg % 2);
+
+    // The weight loader: thread t dequantises two 16-value chunks of row t/2
+    // per K step — chunk index c = K/16, block c / nl, il c % nl.
+    const short w_row = min((short)(tiitg / 2), (short)(n_rows - 1));
+    const short w_chunk0 = (short)(tiitg % 2) * 2;
+    device const block_q * w_blocks = (device const block_q *)(w0 + (uint64_t)w_row * nb01);
+    threadgroup T * ws_row = Ws + w_row * NAX_MM_BK_PADDED + w_chunk0 * 16;
+
+    const short fn = BaseNAXFrag::get_coord().x;   // this lane's column base within a fragment
+
+    device const half * yr[4] = {rows.y[0], rows.y[1], rows.y[2], rows.y[3]};
+
+    NAXTile<float, TM, TN> Dtile;
+    Dtile.clear();
+
+    for (int k0 = 0; k0 < ne00; k0 += NAX_MM_BK) {
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        {
+            const int chunk = (k0 / 16) + w_chunk0;
+            for (short c = 0; c < 2; c++) {
+                T4x4 temp;
+                dequantize_func(w_blocks + (chunk + c) / nl, (short)((chunk + c) % nl), temp);
+                threadgroup vec<T, 4> * dst4 = (threadgroup vec<T, 4> *)(ws_row + c * 16);
+                dst4[0] = temp[0]; dst4[1] = temp[1]; dst4[2] = temp[2]; dst4[3] = temp[3];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        STEEL_PRAGMA_NO_UNROLL
+        for (short kk1 = 0; kk1 < NAX_MM_BK; kk1 += SK) {
+            NAXTile<T, TM, TK> Atile;
+            NAXTile<T, TN, TK> Btile;
+
+            volatile int compiler_barrier;
+
+            // A: this thread's four rows, four halves per fragment row
+            STEEL_PRAGMA_UNROLL
+            for (short iq = 0; iq < TM; iq++) {
+                STEEL_PRAGMA_UNROLL
+                for (short ik = 0; ik < TK; ik++) {
+                    thread auto & f = Atile.frag_at(iq, ik);
+                    const int col = k0 + kk1 + ik * 16 + fn;
+                    const half4 v0 = *(device const half4 *)(yr[iq * 2 + 0] + col);
+                    const half4 v1 = *(device const half4 *)(yr[iq * 2 + 1] + col);
+                    f[0] = T(v0.x); f[1] = T(v0.y); f[2] = T(v0.z); f[3] = T(v0.w);
+                    f[4] = T(v1.x); f[5] = T(v1.y); f[6] = T(v1.z); f[7] = T(v1.w);
+                }
+            }
+            Btile.template load<T, NAX_MM_BK_PADDED, 1>(Ws + tn * NAX_MM_BK_PADDED + kk1);
+
+            tile_matmad_nax(Dtile, Atile, metal::bool_constant<false>{}, Btile, metal::bool_constant<true>{});
+
+            (void)compiler_barrier;
+        }
+    }
+
+    // Store this thread's four output rows, four floats per fragment row;
+    // every fragment index is literal so the accumulator stays in registers.
+    STEEL_PRAGMA_UNROLL
+    for (short iq = 0; iq < TM; iq++) {
+        STEEL_PRAGMA_UNROLL
+        for (short in = 0; in < TN; in++) {
+            const thread auto & f = Dtile.frag_at(iq, in);
+            const short col = tn + in * 16 + fn;
+            mul_mm_nax_store4(rows.d[iq * 2 + 0], rows.valid[iq * 2 + 0], col, n_rows, float4(f[0], f[1], f[2], f[3]));
+            mul_mm_nax_store4(rows.d[iq * 2 + 1], rows.valid[iq * 2 + 1], col, n_rows, float4(f[4], f[5], f[6], f[7]));
+        }
+    }
+}
+
+// The row a thread's fragment row i (0..3) maps to within the 64-row tile: its simdgroup's 32-row half, the
+// fragment (0, 1), the element row (0, 8) and the lane's row within the fragment.
+METAL_FUNC short mul_mm_nax_tile_row(uint sgitg, short i) {
+    return 32 * (short)(sgitg / 2) + (i / 2) * 16 + (i % 2) * 8 + nax::BaseNAXFrag::get_coord().y;
+}
+
+// Dense: the tile kernel's arguments with src1 half, the tensor-op body.
+template<typename T, typename T4x4, typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread T4x4 &)>
+kernel void kernel_mul_mm_nax(device const  uchar * src0,
+                              device const  uchar * src1,
+                              device        float * dst,
+                              constant    int64_t & ne00,
+                              constant    int64_t & ne02,
+                              constant   uint64_t & nb01,
+                              constant   uint64_t & nb02,
+                              constant   uint64_t & nb03,
+                              constant    int64_t & ne12,
+                              constant   uint64_t & nb10,
+                              constant   uint64_t & nb11,
+                              constant   uint64_t & nb12,
+                              constant   uint64_t & nb13,
+                              constant    int64_t & ne0,
+                              constant    int64_t & ne1,
+                              constant       uint & r2,
+                              constant       uint & r3,
+                              threadgroup   uchar * shared_memory [[threadgroup(0)]],
+                              uint3                 tgpig[[threadgroup_position_in_grid]],
+                              uint                  tiitg[[thread_index_in_threadgroup]],
+                              uint                  sgitg[[simdgroup_index_in_threadgroup]]) {
+    const uint r0 = tgpig.y;
+    const uint r1 = tgpig.x;
+    const uint im = tgpig.z;
+
+    const short n_rows = (short)MIN(ne0 - (int64_t)r0 * NAX_MM_BN, NAX_MM_BN);
+    const short n_cols = (short)MIN(ne1 - (int64_t)r1 * NAX_MM_BM, NAX_MM_BM);
+
+    const uint i12 = im % ne12;
+    const uint i13 = im / ne12;
+    const uint64_t offset0 = (i12 / r2) * nb02 + (i13 / r3) * nb03;
+    device const uchar * w0 = src0 + (uint64_t)r0 * NAX_MM_BN * nb01 + offset0;
+    const int64_t im_off = (int64_t)im * ne1 * ne0;
+
+    mul_mm_nax_rows rows;
+    for (short i = 0; i < 4; i++) {
+        const short row = mul_mm_nax_tile_row(sgitg, i);
+        rows.valid[i] = row < n_cols;
+        const int64_t rowc = (int64_t)r1 * NAX_MM_BM + MIN(row, n_cols - 1);
+        rows.y[i] = (device const half *)(src1 + nb13 * i13 + nb12 * i12 + nb11 * rowc);
+        rows.d[i] = dst + rowc * ne0 + (int64_t)r0 * NAX_MM_BN + im_off;
+    }
+    mul_mm_nax_body<T, T4x4, block_q, nl, dequantize_func>(w0, nb01, ne00, n_rows, rows, shared_memory, tiitg, sgitg);
+}
+
+// Routed: one expert per tgpig.z, its matched rows from hids in tiles of 64; addresses as kernel_mul_mm_id_impl's.
+template<typename T, typename T4x4, typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread T4x4 &)>
+METAL_FUNC void mul_mm_id_nax_tile(
+        device const   uchar * src0,
+        device const   uchar * src1,
+        device         float * dst,
+        device const   uchar * hids,
+                     int32_t   i02,
+                     int64_t   r1_off,
+                     int64_t   neh1,
+                     int64_t   nei0,
+                     int64_t   nei1,
+                     int64_t   ne00,
+                    uint64_t   nb01,
+                     int64_t   ne11,
+                    uint64_t   nb11,
+                    uint64_t   nb12,
+                     int64_t   ne0,
+                     int64_t   ne1,
+        threadgroup    uchar * shared_memory,
+                        uint   r0,
+                        uint   tiitg,
+                        uint   sgitg) {
+    threadgroup ushort2 * rowids = (threadgroup ushort2 *)(shared_memory + NAX_MM_WS_BYTES);
+    device const int32_t * ids_i32 = (device const int32_t *) hids;
+    const int64_t this_expert_base = (int64_t)i02 * nei1;
+    const short nr1 = (short)MIN(neh1 - r1_off, NAX_MM_BM);
+    if (tiitg < (uint) nr1) {
+        const int32_t id = ids_i32[this_expert_base + r1_off + tiitg];
+        rowids[tiitg] = ushort2((ushort)(id % nei0), (ushort)(id / nei0));
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const short n_rows = (short)MIN(ne0 - (int64_t)r0 * NAX_MM_BN, NAX_MM_BN);
+    device const uchar * w0 = src0 + (uint64_t)r0 * NAX_MM_BN * nb01;
+    const int64_t ne0ne1 = ne0 * ne1;
+
+    mul_mm_nax_rows rows;
+    for (short i = 0; i < 4; i++) {
+        const short row = mul_mm_nax_tile_row(sgitg, i);
+        rows.valid[i] = row < nr1;
+        const ushort2 id = rowids[MIN(row, nr1 - 1)];
+        rows.y[i] = (device const half *)(src1 + nb12 * id[1] + nb11 * (id[0] % ne11));
+        rows.d[i] = dst + (int64_t)id[0] * ne0 + (int64_t)id[1] * ne0ne1 + (int64_t)r0 * NAX_MM_BN;
+    }
+    mul_mm_nax_body<T, T4x4, block_q, nl, dequantize_func>(w0, nb01, ne00, n_rows, rows, shared_memory, tiitg, sgitg);
+}
