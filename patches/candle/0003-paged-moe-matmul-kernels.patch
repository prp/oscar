+// Takes a precomputed sorted-by-expert routing table rather than scanning per tile, so threadgroup memory scales with
+// the tile, not the table. The experts are read through the address row: column z serves `expert_list[z]`, null none.
+template<typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread half4x4 &)>
+kernel void kernel_mul_mm_id_with_hids(
+        device const ExpertRow * experts,
+        device const   uchar * src1,
+        device         float * dst,
+        device const   uchar * htpe,
+        device const   uchar * hids,
+        device const uint32_t * expert_list,
+        constant     int64_t & nei0,
+        constant     int64_t & nei1,
+        constant     int64_t & ne00,
+        constant     int64_t & ne02,
+        constant    uint64_t & nb01,
+        constant    uint64_t & nb02,
+        constant     int64_t & ne11,
+        constant     int64_t & ne12,
+        constant     int64_t & ne13,
+        constant    uint64_t & nb10,
+        constant    uint64_t & nb11,
+        constant    uint64_t & nb12,
+        constant     int64_t & ne0,
+        constant     int64_t & ne1,
+        constant    uint64_t & nb1,
+        threadgroup    uchar * shared_memory [[threadgroup(0)]],
+        uint3                  tgpig[[threadgroup_position_in_grid]],
+        uint                   tiitg[[thread_index_in_threadgroup]],
+        uint                   sgitg[[simdgroup_index_in_threadgroup]]) {
+
+    const int32_t i02 = tgpig.z;
+    const int64_t r1_off = (int64_t)tgpig.x * BLOCK_SIZE_N;
+
+    // Per-expert match count from htpe.
+    device const uint32_t * tpe_u32 = (device const uint32_t *) htpe;
+    const int64_t neh1 = (int64_t) tpe_u32[i02];
+
+    // Tile is past the matched-row range for this expert — return early.
+    if (r1_off >= neh1) {
+        return;
+    }
+    device const uchar * src0 = (device const uchar *) experts[expert_list[i02]].base;
+    if (src0 == nullptr) {
+        return;
+    }
+
+    tgpig.z = 0;
+
+    // Materialise only this tile's slice of the routing table into the buffer the
+    // impl already consumes — this is what keeps TG memory tile-sized.
+    threadgroup ushort2 * rowids = (threadgroup ushort2 *)(shared_memory + 8192);
+
+    device const int32_t * ids_i32 = (device const int32_t *) hids;
+    const int64_t this_expert_base = (int64_t)i02 * nei1;
+
+    // One entry per thread; threads past `nr1` write out of bounds, but the impl clamps `n_cols` so none is read.
+    const int64_t nr1 = (neh1 - r1_off < BLOCK_SIZE_N) ? (neh1 - r1_off) : BLOCK_SIZE_N;
+    if (tiitg < (uint) nr1) {
+        const int32_t id = ids_i32[this_expert_base + r1_off + tiitg];
+        rowids[tiitg] = ushort2((ushort)(id % nei0), (ushort)(id / nei0));
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    // The impl indexes `rowids` from `r1`, and our slice starts at 0; the outer grid drives the routing axis instead.
+    tgpig.x = 0;
+
+    kernel_mul_mm_id_impl<block_q, nl, dequantize_func>(
+        src0,
+        src1,
+        rowids,
+        dst,
+        ne00,
+        ne02,
+        nb01,
+        nb02,
+        ne11,
+        ne12,
+        nb10,
+        nb11,
+        nb12,
+        ne0,
+        nr1,
+        ne0*ne1,
+        shared_memory,
+        tgpig,
+        tiitg,
+        sgitg);
+}
