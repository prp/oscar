+// Lets a crate outside this one bring its own GGUF architecture: register a
+// factory before load, and the pipeline drives the result through [`GgufArch`].
+use std::collections::HashMap;
+use std::io::{Read, Seek};
+use std::sync::{Arc, RwLock};
+
+use candle_core::quantized::gguf_file::Value;
+use candle_core::{DType, Device, Tensor};
+
+use crate::device_map::DeviceMapper;
+use crate::kv_cache::EitherCache;
+use crate::paged_attention::AttentionImplementation;
+use crate::pipeline::text_models_inputs_processor::PagedAttentionInputMetadata;
+
+pub trait ReadSeek: Read + Seek {}
+impl<T: Read + Seek> ReadSeek for T {}
+
+/// A GGUF file with its reader type erased, so a registered factory can name the [`Content`] it is handed.
+pub type GgufReader = Box<dyn ReadSeek + Send>;
+
+/// One registered architecture's model, as the pipeline drives it.
+pub trait GgufArch: Send + Sync {
+    fn forward(
+        &self,
+        input_ids: &Tensor,
+        seqlen_offsets: &[usize],
+        context_lens: Vec<(usize, usize)>,
+        paged_attn_meta: Option<(Vec<(Tensor, Tensor)>, &PagedAttentionInputMetadata)>,
+    ) -> candle_core::Result<Tensor>;
+
+    fn cache(&self) -> &EitherCache;
+    fn device(&self) -> &Device;
+    fn max_seq_len(&self) -> usize;
+    fn num_layers(&self) -> usize;
+}
+
+/// Builds one model from its weight files; the parameters are `FromGGUF`'s, with the reader erased.
+pub type GgufArchFactory = fn(
+    Content<'_, GgufReader>,
+    &Device,
+    Box<dyn DeviceMapper + Send + Sync>,
+    AttentionImplementation,
+    DType,
+) -> candle_core::Result<Arc<dyn GgufArch>>;
+
+/// Reads one architecture's declaration from the file header alone, so a planner asks before anything is allocated.
+pub type GgufArchDeclare =
+    fn(&Content<'_, GgufReader>) -> candle_core::Result<ArchDeclaration>;
+
+static REGISTRY: RwLock<Option<HashMap<String, (GgufArchFactory, GgufArchDeclare)>>> =
+    RwLock::new(None);
+
+/// Registers `factory` and `declare` for `arch`, ahead of any architecture of that name compiled in.
+pub fn register_gguf_arch(
+    arch: GGUFArchitecture,
+    factory: GgufArchFactory,
+    declare: GgufArchDeclare,
+) {
+    REGISTRY
+        .write()
+        .expect("gguf arch registry")
+        .get_or_insert_with(HashMap::new)
+        .insert(arch.to_string(), (factory, declare));
+}
+
+pub(crate) fn gguf_arch_factory(arch: GGUFArchitecture) -> Option<GgufArchFactory> {
+    REGISTRY
+        .read()
+        .expect("gguf arch registry")
+        .as_ref()?
+        .get(&arch.to_string())
+        .map(|(factory, _)| *factory)
+}
+
+/// What one architecture declares about a model, from the file header alone: the one reading the loader
+/// builds from, the caches size from and the plan evaluates, so a fact is interpreted once, by its module.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct ArchDeclaration {
+    /// One entry per block in the file, in file order.
+    pub layers: Vec<LayerDecl>,
+    pub attention: AttentionDecl,
+    pub experts: ExpertDecl,
+    /// The state a sequence holds where the architecture is recurrent: the layout its cache asks the pool for.
+    pub recurrent: Option<RecurrentDecl>,
+    /// `*.embedding_length`.
+    pub hidden: u64,
+    /// `*.context_length` under the port's cap: the most a plan's guarantee may promise.
+    pub context_length: u64,
+    /// `*.embedding_length_per_layer_input`: the n-gram row-gather table's row width, 0 without a table.
+    pub ple_row_width: u64,
+    /// The file's own, filled by [`declare_arch`] for every architecture alike.
+    pub vocab: VocabDecl,
+}
+
+/// One block: its attention kind, its feed-forward kind and whether it is causal trunk or a trailing draft
+/// block. The kinds are independent (recurrent state beside routed experts), so a consumer counts what it needs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LayerDecl {
+    pub attention: LayerAttention,
+    pub ffn: LayerFfn,
+    pub role: LayerRole,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LayerAttention {
+    /// Holds KV in the cache, with this layer's own head count.
+    Kv { heads: u64 },
+    /// Holds a fixed-size recurrent state instead (GDN, KDA).
+    Recurrent,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LayerFfn {
+    Dense,
+    Routed,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LayerRole {
+    /// Part of the causal forward.
+    Trunk,
+    /// A trailing nextn/MTP block: outside the causal forward, and never a pool KV layer.
+    Nextn,
+}
+
+/// The attention dimensions the cache and the plan size from; on absorbed MLA `key_len` spans the whole row.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct AttentionDecl {
+    pub head_count: u64,
+    pub key_len: u64,
+    pub value_len: u64,
+    pub kv_lora_rank: Option<u64>,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ExpertDecl {
+    /// `*.expert_count`, 0 on a dense model.
+    pub count: u64,
+    /// `*.expert_used_count`: the slots ONE token needs resident at once.
+    pub per_token: u64,
+}
+
+/// The recurrent state's layout as the architecture builds its cache (the `conv_dim`, `conv_width` and
+/// `state_dims` it hands `HybridCache`), so a plan prices a state by the shape the take asks for.
+#[derive(Clone, Debug, PartialEq)]
+pub struct RecurrentDecl {
+    pub config: crate::kv_cache::RecurrentLayerConfig,
+    pub dtypes: crate::kv_cache::RecurrentStateDtypes,
+    /// Blocks whose state differs from `config` — the PLE row's wider conv —
+    /// by block index, as `HybridCacheConfig::recurrent_overrides`.
+    pub overrides: Vec<(usize, crate::kv_cache::RecurrentLayerConfig)>,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct VocabDecl {
+    pub tokens: u64,
+    /// The tokens' bytes in all.
+    pub bytes: u64,
+    pub merges: u64,
+}
+
+impl ArchDeclaration {
+    /// Blocks of the causal forward: every block but the trailing draft ones.
+    pub fn trunk_layers(&self) -> usize {
+        self.layers.iter().filter(|l| l.role == LayerRole::Trunk).count()
+    }
+
+    /// The trailing nextn/MTP blocks.
+    pub fn nextn_layers(&self) -> usize {
+        self.layers.iter().filter(|l| l.role == LayerRole::Nextn).count()
+    }
+
+    /// Trunk blocks that hold KV in the cache.
+    pub fn kv_bearing_layers(&self) -> usize {
+        self.trunk().filter(|l| matches!(l.attention, LayerAttention::Kv { .. })).count()
+    }
+
+    /// Trunk blocks that hold a recurrent state instead.
+    pub fn recurrent_layers(&self) -> usize {
+        self.trunk().filter(|l| l.attention == LayerAttention::Recurrent).count()
+    }
+
+    /// Trunk blocks with routed experts: the dispatcher's ordinals.
+    pub fn moe_layers(&self) -> usize {
+        self.trunk().filter(|l| l.ffn == LayerFfn::Routed).count()
+    }
+
+    /// One key head's width, and one value head's: the declared length, or the default a head gets when
+    /// the file states none, applied once here for every reader of these keys.
+    pub fn k_head_dim(&self) -> u64 {
+        self.head_dim_or_default(self.attention.key_len)
+    }
+
+    pub fn v_head_dim(&self) -> u64 {
+        self.head_dim_or_default(self.attention.value_len)
+    }
+
+    fn head_dim_or_default(&self, declared: u64) -> u64 {
+        match (declared, self.attention.head_count) {
+            (0, heads) if heads > 0 => self.hidden / heads,
+            (len, _) => len,
+        }
+    }
+
+    /// KV bytes per token across the cache's layers. The contiguous cache stores absorbed-MLA K and V apart
+    /// (key+value wide); the paged latent cache stores the row once, so such a plan charges `key_len` alone.
+    pub fn kv_bytes_per_token(&self, bytes_per_element: u64) -> u64 {
+        let width = match self.attention.kv_lora_rank {
+            Some(_) => self.k_head_dim(),
+            None => self.k_head_dim() + self.v_head_dim(),
+        };
+        self.trunk()
+            .filter_map(|l| match l.attention {
+                LayerAttention::Kv { heads } => Some(heads),
+                LayerAttention::Recurrent => None,
+            })
+            .sum::<u64>()
+            .saturating_mul(width)
+            .saturating_mul(bytes_per_element)
+    }
+
+    /// The layout a sequence's state is taken at: per recurrent layer, the conv tensor's shape and dtype then
+    /// the recurrent's, as `RecurrentStatePool` hands the memory. `model_dtype` resolves a state following the model's.
+    pub fn recurrent_state_layout(
+        &self,
+        model_dtype: DType,
+    ) -> Option<crate::kv_cache::RecurrentStateLayout> {
+        let r = self.recurrent.as_ref()?;
+        let layers = self
+            .layers
+            .iter()
+            .enumerate()
+            .filter(|(_, l)| l.role == LayerRole::Trunk && l.attention == LayerAttention::Recurrent)
+            .map(|(i, _)| {
+                let c = r.overrides.iter().find(|(j, _)| *j == i).map_or(&r.config, |(_, c)| c);
+                let mut recurrent_shape = vec![1usize];
+                recurrent_shape.extend_from_slice(&c.state_dims);
+                (
+                    (1, c.conv_dim, c.conv_width),
+                    r.dtypes.conv.unwrap_or(model_dtype),
+                    recurrent_shape,
+                    r.dtypes.state.unwrap_or(model_dtype),
+                )
+            })
+            .collect();
+        Some(crate::kv_cache::RecurrentStateLayout { layers })
+    }
+
+    fn trunk(&self) -> impl Iterator<Item = &LayerDecl> {
+        self.layers.iter().filter(|l| l.role == LayerRole::Trunk)
+    }
+}
+
+/// The declaration is the model config: the block pool, the cache engine and the auto device map all
+/// size from this trait, reading the architecture's own declaration, never a second reading of the header.
+impl crate::paged_attention::ModelConfigLike for ArchDeclaration {
+    fn max_seq_len(&self) -> usize {
+        self.context_length as usize
+    }
+    fn num_layers(&self) -> usize {
+        self.layers.len()
+    }
+    fn hidden_size(&self) -> usize {
+        self.hidden as usize
+    }
+    /// The widest layer's, which is what a uniform block must hold.
+    fn num_kv_heads(&self) -> usize {
+        self.layers
+            .iter()
+            .filter_map(|l| match l.attention {
+                LayerAttention::Kv { heads } => Some(heads as usize),
+                LayerAttention::Recurrent => None,
+            })
+            .max()
+            .unwrap_or(0)
+    }
+    fn num_attn_heads(&self) -> usize {
+        self.attention.head_count as usize
+    }
+    fn k_head_dim(&self) -> usize {
+        ArchDeclaration::k_head_dim(self) as usize
+    }
+    fn v_head_dim(&self) -> usize {
+        ArchDeclaration::v_head_dim(self) as usize
+    }
+    fn kv_cache_layout(&self) -> crate::paged_attention::KvCacheLayout {
+        match self.attention.kv_lora_rank {
+            Some(rank) => crate::paged_attention::KvCacheLayout::Mla {
+                kv_lora_rank: rank as usize,
+                kpe_head_dim: (self.k_head_dim() as usize).saturating_sub(rank as usize),
+            },
+            None => crate::paged_attention::KvCacheLayout::Standard,
+        }
+    }
+    /// A hybrid's recurrent block holds no KV, nor does a trailing draft block (a drafter caches it privately).
+    fn kv_bearing_layer(&self, layer_idx: usize) -> bool {
+        self.layers.get(layer_idx).is_some_and(|l| {
+            l.role == LayerRole::Trunk && matches!(l.attention, LayerAttention::Kv { .. })
+        })
+    }
+    fn num_kv_bearing_layers(&self) -> usize {
+        self.kv_bearing_layers().max(1)
+    }
+}
+
+impl VocabDecl {
+    /// The tokenizer's own keys, which every architecture shares.
+    pub fn from_metadata(metadata: &HashMap<String, Value>) -> Self {
+        let tokens = match metadata.get("tokenizer.ggml.tokens") {
+            Some(Value::Array(a)) => a,
+            _ => return Self::default(),
+        };
+        Self {
+            tokens: tokens.len() as u64,
+            bytes: tokens
+                .iter()
+                .map(|t| t.to_string().map_or(0, |s| s.len() as u64))
+                .sum(),
+            merges: match metadata.get("tokenizer.ggml.merges") {
+                Some(Value::Array(a)) => a.len() as u64,
+                _ => 0,
+            },
+        }
+    }
+}
+
+/// The one reading of a model's layer composition and dimensions, declared by the architecture's own
+/// module. The vocabulary is the file's, not the architecture's, so it is filled here for every one alike.
+pub fn declare_arch(content: &Content<'_, GgufReader>) -> candle_core::Result<ArchDeclaration> {
+    let arch = content.arch();
+    let declare = REGISTRY
+        .read()
+        .expect("gguf arch registry")
+        .as_ref()
+        .and_then(|r| r.get(&arch.to_string()).map(|(_, declare)| *declare))
+        .ok_or_else(|| {
+            candle_core::Error::Msg(format!("no architecture registered for `{arch}`"))
+        })?;
+    let mut declaration = declare(content)?;
+    declaration.vocab = VocabDecl::from_metadata(content.get_metadata());
+    Ok(declaration)
+}
