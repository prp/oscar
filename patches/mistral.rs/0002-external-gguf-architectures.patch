+impl Config<ParamsGGUF<'_, GgufReader>, NoAdapter> {
+    /// Build through the [`GgufArch`] registered for `arch` rather than an architecture compiled into this crate.
+    pub fn try_into_registered_model(
+        self,
+        arch: GGUFArchitecture,
+    ) -> Result<Arc<dyn GgufArch>, candle_core::Error> {
+        let ParamsGGUF(ct, Device { device, mapper }, attention_implementation, dtype) = self.quant;
+        let Some(factory) = gguf_arch_factory(arch) else {
+            candle_core::bail!("Unsupported architecture `{arch:?}` for GGUF")
+        };
+        factory(ct, device, mapper, attention_implementation, dtype)
+    }
