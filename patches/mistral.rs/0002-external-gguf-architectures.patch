+/// Stock GPT-2 / llama-bpe split. Single-digit `\p{N}`, no Han handling.
+pub const SPLIT_GPT2: &str = "(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\\r\\n\\p{L}\\p{N}]?\\p{L}+|\\p{N}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+";
+
+/// Kimi K2/K3: Han runs are their own class, letter runs exclude Han, and digits group in 1-3s.
+pub const SPLIT_KIMI_K2: &str = concat!(
+    "\\p{Han}+",
+    "|[^\\r\\n\\p{L}\\p{N}]?[\\p{Lu}\\p{Lt}\\p{Lm}\\p{Lo}\\p{M}--\\p{Han}]*",
+    "[\\p{Ll}\\p{Lm}\\p{Lo}\\p{M}--\\p{Han}]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?",
+    "|[^\\r\\n\\p{L}\\p{N}]?[\\p{Lu}\\p{Lt}\\p{Lm}\\p{Lo}\\p{M}--\\p{Han}]+",
+    "[\\p{Ll}\\p{Lm}\\p{Lo}\\p{M}--\\p{Han}]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?",
+    "|\\p{N}{1,3}",
+    "| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*",
+    "|\\s*[\\r\\n]+",
+    "|\\s+(?!\\S)",
+    "|\\s+",
+);
+
+/// Anything unrecognised keeps the GPT-2 behaviour rather than failing: every model loading reaches this.
+fn split_regex_for_pre(pre: Option<&str>) -> &'static str {
+    match pre {
+        Some("kimi-k2") => SPLIT_KIMI_K2,
+        _ => SPLIT_GPT2,
+    }
+}
