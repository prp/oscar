+/// A device-sampled step's logits row, brought to the host while a trace records: the row's buffer goes
+/// back to the pool with the step, and the trace reads the copy when the token is read.
+fn traced_logits(logits: &Tensor) -> Result<Option<Tensor>, candle_core::Error> {
+    sampling::logit_trace().map(|_| logits.to_device(&Device::Cpu)).transpose()
+}
+
+/// A device-sampled token as the trace leaves it: recorded beside its step's logits, under teacher forcing the
+/// base recording's token instead; a forced token cannot sit in a presence penalty's context (the drawn one's).
+fn traced_token(token: u32, logits: Option<&Tensor>, penalised: bool) -> Result<u32, candle_core::Error> {
+    let (Some(trace), Some(logits)) = (sampling::logit_trace(), logits) else {
+        return Ok(token);
+    };
+    match trace.note_step_logits(token, logits, false) {
+        Some(forced) if penalised => candle_core::bail!(
+            "teacher forcing under presence penalty: context would mark sampler's {token}, not forced {forced}"
+        ),
+        Some(forced) => Ok(forced),
+        None => Ok(token),
+    }
+}
