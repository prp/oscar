+    /// The hybrid models' recurrent layers read their pool slots through the state-indices tensor; paged
+    /// attention keeps KV apart, so the indices are set here for every decode forward.
+    fn set_recurrent_state_indices(&self, input_seqs: &[&mut Sequence]) {
