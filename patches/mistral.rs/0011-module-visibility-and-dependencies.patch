+    /// The device sampler for a sequence whose decode step samples on the device: on Metal, a sampler the device
+    /// covers, no logprobs, no constrained decoding. Whether the step may queue ahead is the sampler's `active()`.
+    fn device_sampler_for(
+        &self,
+        seq: &mut Sequence,
+    ) -> Option<(Arc<dyn crate::sampler::DeviceSampler>, crate::sampler::DeviceSampleSpec)> {
+        if !matches!(self.device(), Device::Metal(_))
+            || seq.return_logprobs()
+            || !matches!(seq.recognizer, crate::sequence::SequenceRecognizer::None)
+            || self.get_metadata().is_xlora
+        {
+            return None;
+        }
+        let sampler = crate::sampler::device_sampler()?;
+        let spec = seq.sampler().device_spec()?;
+        sampler.supports(&spec).then_some((sampler, spec))
+    }
+
+    /// A device-sampled token as the host sampler would report it.
+    fn device_logprobs(&self, token: u32, logprob: f32) -> Logprobs {
+        let bytes = self
+            .tokenizer()
+            .and_then(|t| t.decode(&[token], false).ok());
+        Logprobs { token, logprob, top_logprobs: None, bytes }
+    }
+
+    /// One decode step with the sampler on the device, the host reading only the token. Drained (`queue_ahead`
+    /// false) the step commits before the next encodes, keeping a drafter's lead; pipelined, the next encodes first.
+    async fn step_device(
+        &mut self,
+        input_seqs: &mut [&mut Sequence],
+        metadata: PagedAttentionMeta,
+        prefix_cacher: &mut PrefixCacheManagerV2,
+        disable_eos_stop: bool,
+        rng: Arc<std::sync::Mutex<Isaac64Rng>>,
+        sampler: Arc<dyn crate::sampler::DeviceSampler>,
+        spec: crate::sampler::DeviceSampleSpec,
+        queue_ahead: bool,
+    ) -> Result<Duration, candle_core::Error> {
+        use crate::sequence::{InFlightStep, SampleBuffers};
+        let device = self.device();
+        let Device::Metal(metal) = &device else {
+            candle_core::bail!("device-sampled step: Metal only");
+        };
+        let t0 = Instant::now();
+        // Drained, a step the pipelined path left queued (the regime moved under the sequence) is retired first, alone.
+        if !queue_ahead {
+            if let Some(cur) = input_seqs[0].in_flight.take() {
+                metal.flush_commands()?;
+                metal.wait_for_completion(cur.generation)?;
+                let (token, logprob) = sampler.read(&cur.out)?;
+                let token = traced_token(token, cur.logits.as_ref(), cur.seen.is_some())?;
+                input_seqs[0].sample_buffers = Some(SampleBuffers { out: cur.out, seen: cur.seen });
+                let logprobs = self.device_logprobs(token, logprob);
+                self.commit_sampled_tok(input_seqs[0], logprobs, prefix_cacher, disable_eos_stop)
+                    .await?;
+                return Ok(t0.elapsed());
+            }
+        }
+        if input_seqs[0].device_seed == 0 {
+            let seed = rand::RngCore::next_u64(&mut *rng.lock().unwrap());
+            input_seqs[0].device_seed = seed | 1;
+        }
+        let seed = input_seqs[0].device_seed;
+        if !queue_ahead {
+            let logits = self.forward_decode(input_seqs, metadata, None)?;
+            let kept = input_seqs[0].sample_buffers.take();
+            let out = match &kept {
+                Some(k) => k.out.clone(),
+                None => sampler.output(&device)?,
+            };
+            let seen = match kept.and_then(|k| k.seen) {
+                Some(seen) => Some(seen),
+                None => (spec.presence_penalty != 0.0)
+                    .then(|| sampler.context(&device, logits.elem_count(), input_seqs[0].get_toks()))
+                    .transpose()?,
+            };
+            let position = input_seqs[0].len() as u64;
+            let generation = metal.next_completion_generation()?;
+            sampler.sample(&logits, &spec, seed, position, &out, seen.as_ref())?;
+            metal.flush_commands()?;
+            metal.wait_for_completion(generation)?;
+            let (token, logprob) = sampler.read(&out)?;
+            let token = traced_token(token, Some(&logits), seen.is_some())?;
+            input_seqs[0].sample_buffers = Some(SampleBuffers { out, seen });
+            let logprobs = self.device_logprobs(token, logprob);
+            self.commit_sampled_tok(input_seqs[0], logprobs, prefix_cacher, disable_eos_stop)
+                .await?;
+            return Ok(t0.elapsed());
+        }
+        // Nothing queued: this position's step from the committed token, the penalty's context from the tokens so far.
+        if input_seqs[0].in_flight.is_none() {
+            let logits = self.forward_decode(input_seqs, metadata.clone(), None)?;
+            let position = input_seqs[0].len() as u64;
+            let out = sampler.output(&device)?;
+            let seen = (spec.presence_penalty != 0.0)
+                .then(|| sampler.context(&device, logits.elem_count(), input_seqs[0].get_toks()))
+                .transpose()?;
+            // The generation the open buffer signals; the sampler stays in it and the next step's dispatches
+            // commit it, so no boundary sits between the sampler and the embedding that reads its token.
+            let generation = metal.next_completion_generation()?;
+            sampler.sample(&logits, &spec, seed, position, &out, seen.as_ref())?;
+            let logits = traced_logits(&logits)?;
+            input_seqs[0].in_flight = Some(InFlightStep { out, generation, consumed: None, seen, logits });
+        }
+        // The next position's step, its token the queued sampler's output; it writes the buffer the queued
+        // step's embedding has read by then: two outputs alternate for the sequence's life.
+        let mut cur = input_seqs[0].in_flight.take().expect("a queued step");
+        let ids = cur.out.narrow(0, 0, 1)?.unsqueeze(0)?;
+        let next_out = match cur.consumed.take() {
+            Some(free) => free,
+            None => sampler.output(&device)?,
+        };
+        input_seqs[0].in_flight = Some(InFlightStep {
+            out: cur.out.clone(),
+            generation: cur.generation,
+            consumed: None,
+            seen: None,
+            logits: None,
+        });
+        let logits = self.forward_decode(input_seqs, metadata, Some(ids))?;
+        let position = (input_seqs[0].len() + 1) as u64;
+        let next_generation = metal.next_completion_generation()?;
+        sampler.sample(&logits, &spec, seed, position, &next_out, cur.seen.as_ref())?;
+        let logits = traced_logits(&logits)?;
+        // Retire the queued token while the next step runs; its buffer stays
+        // referenced until the step reading it has completed.
+        input_seqs[0].in_flight = Some(InFlightStep {
+            out: next_out,
+            generation: next_generation,
+            consumed: Some(cur.out.clone()),
+            seen: cur.seen,
+            logits,
+        });
+        // The queued step's buffer committed under this step's dispatches; the flush covers a short step.
+        metal.flush_commands()?;
