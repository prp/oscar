+    /// The weight in `dtype`, and in F32 for the fused kernels (the cast `weight_for` would otherwise make in
+    /// the first forward), both built on the host from a host `scale` and placed once on `device`.
+    pub fn new_with_dtype(
+        scale: QTensor,
+        eps: f32,
+        dtype: candle_core::DType,
+        device: &candle_core::Device,
+    ) -> Result<Self> {
+        let scale = scale.dequantize(&candle_core::Device::Cpu)?.to_dtype(dtype)?;
+        let alt = (dtype != candle_core::DType::F32)
+            .then(|| scale.to_dtype(candle_core::DType::F32)?.to_device_kept(device))
+            .transpose()?;
+        Ok(Self {
+            eps: eps as f64,
+            weight: scale.to_device_kept(device)?,
+            weight_alt: std::sync::Arc::new(std::sync::Mutex::new(alt)),
+        })
+    }
+
+    /// This norm on another device, its cast cache empty, so taking its weight never touches the live norm's.
+    pub fn to_device(&self, device: &candle_core::Device, dtype: candle_core::DType) -> Result<Self> {
+        Ok(Self {
+            eps: self.eps,
+            weight: self.weight.to_device(device)?.to_dtype(dtype)?,
+            weight_alt: std::sync::Arc::new(std::sync::Mutex::new(None)),
+        })
+    }
+
+    /// Pick (and lazily cache) a weight matching `dtype`; fused `rms_norm` requires `xs.dtype() == alpha.dtype()`.
+    fn weight_for(&self, dtype: candle_core::DType) -> Result<Tensor> {
+        if self.weight.dtype() == dtype {
+            return Ok(self.weight.clone());
+        }
+        let mut cache = self.weight_alt.lock().unwrap();
+        if let Some(ref t) = *cache {
+            if t.dtype() == dtype {
+                return Ok(t.clone());
+            }
+        }
+        let cast = self.weight.to_dtype(dtype)?;
+        *cache = Some(cast.clone());
+        Ok(cast)
+    }
+
     pub fn forward(&self, x: &Tensor) -> Result<Tensor> {
-        candle_nn::ops::rms_norm(&x.contiguous()?, &self.weight, self.eps as f32)
+        let weight = self.weight_for(x.dtype())?;
+        candle_nn::ops::rms_norm(&x.contiguous()?, &weight, self.eps as f32)
+    }
+
+    /// Public access to the dtype-matched weight (for fused Metal kernels).
+    pub fn weight_for_dtype(&self, dtype: candle_core::DType) -> Result<Tensor> {
+        self.weight_for(dtype)
+    }
+
+    pub fn eps_f32(&self) -> f32 {
+        self.eps as f32
     }
 }
 
