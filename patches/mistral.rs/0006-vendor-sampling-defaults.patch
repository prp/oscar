+/// The most complete row the model's authors published per generation mode, each whole on its own: the
+/// embedder installs what it has; the shipped `generation_config.json` stands in for a mode with no row.
+#[derive(Clone, Debug, Default)]
+pub struct ModeGenerationDefaults {
+    pub thinking: Option<ModelGenerationDefaults>,
+    pub non_thinking: Option<ModelGenerationDefaults>,
+}
+
+impl ModeGenerationDefaults {
+    /// The row for the mode the request carries, or `None` when its authors
+    /// published none and the shipped file should stand in.
+    pub fn row(&self, thinking: bool) -> Option<&ModelGenerationDefaults> {
+        [&self.non_thinking, &self.thinking][usize::from(thinking)].as_ref()
+    }
+}
+
+static MODE_DEFAULTS: OnceLock<ModeGenerationDefaults> = OnceLock::new();
+
+/// Install the per-mode rows before the first request; later calls are ignored. Unset, the shipped row covers both.
+pub fn set_mode_generation_defaults(defaults: ModeGenerationDefaults) {
+    let _ = MODE_DEFAULTS.set(defaults);
+}
+
+/// The installed per-mode rows, or `None` when the embedder installed none.
+pub fn mode_generation_defaults() -> Option<&'static ModeGenerationDefaults> {
+    MODE_DEFAULTS.get()
+}
