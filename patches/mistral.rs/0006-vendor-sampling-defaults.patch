+/// A row's sampling parameters a device sampler can take: no temperature is greedy, a temperature samples under
+/// top-k, top-p, then min-p; a presence penalty (0 for none) comes off every held token's logit first.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct DeviceSampleSpec {
+    pub temperature: Option<f32>,
+    pub top_k: u32,
+    pub top_p: f32,
+    pub min_p: f32,
+    pub presence_penalty: f32,
+}
+
+/// The sampler a runtime installs on the device: one row of logits sampled into a two-word tensor (the token and
+/// its log-probability's bits) the next step's embedding reads in place, read back once the step's buffer completed.
+pub trait DeviceSampler: Send + Sync {
+    /// Whether a decode step may queue ahead now; no while a drafter is live, whose lead the queued step would eat.
+    fn active(&self) -> bool {
+        true
+    }
+    fn supports(&self, spec: &DeviceSampleSpec) -> bool;
+    /// A two-word output the caller keeps across steps.
+    fn output(&self, device: &Device) -> Result<Tensor>;
+    /// The presence penalty's context: the sequence's tokens so far over `vocab` entries; the sampler adds
+    /// each token it decides, so the caller builds it once per sequence.
+    fn context(&self, device: &Device, vocab: usize, tokens: &[u32]) -> Result<Tensor>;
+    fn sample(
+        &self,
+        logits: &Tensor,
+        spec: &DeviceSampleSpec,
+        seed: u64,
+        position: u64,
+        out: &Tensor,
+        seen: Option<&Tensor>,
+    ) -> Result<()>;
+    fn read(&self, out: &Tensor) -> Result<(u32, f32)>;
+}
+
+static DEVICE_SAMPLER: std::sync::RwLock<Option<Arc<dyn DeviceSampler>>> =
+    std::sync::RwLock::new(None);
+
+pub fn register_device_sampler(sampler: Arc<dyn DeviceSampler>) {
+    *DEVICE_SAMPLER.write().expect("device sampler registry") = Some(sampler);
+}
+
+pub(crate) fn device_sampler() -> Option<Arc<dyn DeviceSampler>> {
+    DEVICE_SAMPLER.read().expect("device sampler registry").clone()
+}
+
+impl Sampler {
+    /// This sampler as a device spec, when it has one: no frequency or
+    /// repetition penalty in force, no DRY, no logits processors.
+    pub fn device_spec(&self) -> Option<DeviceSampleSpec> {
+        let plain = self.frequency_penalty.is_none_or(|v| v == 0.0)
+            && self.repetition_penalty.is_none_or(|v| v == 1.0)
+            && self.dry_params.is_none()
+            && self.logits_processors.is_empty();
+        plain.then(|| DeviceSampleSpec {
+            temperature: self.temperature.map(|t| t as f32),
+            top_k: u32::try_from(self.top_k).unwrap_or(0),
+            top_p: self.top_p as f32,
+            min_p: self.min_p as f32,
+            presence_penalty: self.presence_penalty.unwrap_or(0.0),
+        })
     }
 }
