@@ -130,6 +130,27 @@ impl QuantMethod for GgufMatMul {
         }
     }
 
+
+    #[cfg(feature = "metal")]
+    fn metal_quant_weight_view(&self) -> Option<crate::MetalQuantWeightView<'_>> {
+        // fused-matvec path folds matvec only, no bias broadcast.
+        if self.b.is_some() {
+            return None;
+        }
+        match &self.w {
+            QMatMul::QTensor(q) => {
+                let storage = q.metal_storage()?;
+                let dims = q.shape().dims();
+                let (n, k) = match dims {
+                    [n, k] => (*n, *k),
+                    _ => return None,
+                };
+                Some(crate::MetalQuantWeightView { storage, n, k })
+            }
+            QMatMul::Tensor(_) | QMatMul::TensorF16(_) => None,
+        }
+    }
+
     fn apply_isq(
         self: Arc<Self>,
         dtype: Option<IsqType>,
@@ -241,6 +262,10 @@ impl QuantizedSerde for GgufMatMul {
                     GgmlDType::Q5K => 13,
                     GgmlDType::Q6K => 14,
                     GgmlDType::Q8K => 15,
+                    // Dequantise-only here, but the tags belong to the same ggml enumeration and round-trip for free.
+                    GgmlDType::Iq2XXS => 16,
+                    GgmlDType::Iq3XXS => 18,
+                    GgmlDType::Iq1S => 19,
                     // https://github.com/ggerganov/ggml/blob/29d87fc6676e7ed0cdfdec0804b06001d9c2bb44/include/ggml.h#L389
                     GgmlDType::BF16 => 30,
