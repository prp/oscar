+/// One sequence's recurrent state: every recurrent layer's conv and recurrent tensor, in layer order. On
+/// the device they are storages over one buffer (`bytes`), one blit to copy; off it (`None`) one copy per layer.
+#[derive(Clone)]
+pub struct RecurrentState(Arc<StateInner>);
+
+struct StateInner {
+    bytes: Option<Tensor>,
+    layers: Vec<(Tensor, Tensor)>,
+    /// The position the state is valid at, fixed when a snapshot is taken; zero on a live slot (the pools carry it).
+    seqlen_offset: usize,
+    /// The memory's hold on the object, released with the last handle.
+    _hold: Box<dyn std::any::Any + Send + Sync>,
+}
+
+impl std::fmt::Debug for RecurrentState {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "RecurrentState({} layers at {})", self.0.layers.len(), self.0.seqlen_offset)
+    }
+}
+
+impl RecurrentState {
+    /// A state over `layers`, `bytes` their one device buffer, `hold` what keeps the memory's object alive.
+    pub fn new(bytes: Option<Tensor>, layers: Vec<(Tensor, Tensor)>, hold: Box<dyn std::any::Any + Send + Sync>) -> Self {
+        Self(Arc::new(StateInner { bytes, layers, seqlen_offset: 0, _hold: hold }))
+    }
+
+    /// A state of its own tensors, one per layer: a memory for tests.
+    pub fn from_layers(layers: Vec<(Tensor, Tensor)>, seqlen_offset: usize) -> Self {
+        Self(Arc::new(StateInner { bytes: None, layers, seqlen_offset, _hold: Box::new(()) }))
+    }
+
+    /// Each recurrent layer's `(conv, recurrent)` tensors, in layer order.
+    pub fn layers(&self) -> &[(Tensor, Tensor)] {
+        &self.0.layers
+    }
+
+    /// The position the state is valid at.
+    pub fn seqlen_offset(&self) -> usize {
+        self.0.seqlen_offset
+    }
+
+    /// The same object marked valid at `seqlen_offset`: a freshly taken state, one handle on it.
+    pub fn at(mut self, seqlen_offset: usize) -> Self {
+        Arc::get_mut(&mut self.0).expect("a freshly taken state has one handle").seqlen_offset = seqlen_offset;
+        self
+    }
+
+    /// The object's bytes as the device holds them, page-rounded: zero off the device.
+    pub fn bytes(&self) -> usize {
+        self.0.bytes.as_ref().map_or(0, Tensor::elem_count)
+    }
+
+    /// Every layer's tensors become `src`'s: one blit on the device.
+    pub fn copy_from(&self, src: &RecurrentState) -> Result<()> {
+        match (&self.0.bytes, &src.0.bytes) {
+            (Some(dst), Some(from)) => blit(dst, from),
+            _ => {
+                if self.0.layers.len() != src.0.layers.len() {
+                    candle_core::bail!("state of {} layers cannot take one of {}", self.0.layers.len(), src.0.layers.len());
+                }
+                for ((c, r), (sc, sr)) in self.0.layers.iter().zip(&src.0.layers) {
+                    c.slice_set(&sc.to_device(c.device())?, 0, 0)?;
+                    r.slice_set(&sr.to_device(r.device())?, 0, 0)?;
+                }
+                Ok(())
+            }
+        }
+    }
+
+    /// Every layer's tensors zeroed: one fill on the device.
+    pub fn zero(&self) -> Result<()> {
+        match &self.0.bytes {
+            Some(bytes) => fill(bytes, 0),
+            None => {
+                for (c, r) in &self.0.layers {
+                    c.slice_set(&c.zeros_like()?, 0, 0)?;
+                    r.slice_set(&r.zeros_like()?, 0, 0)?;
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+/// `dst`'s bytes become `src`'s: a blit between two contiguous runs of one length, `dst` a storage over its buffer.
+fn blit(dst: &Tensor, src: &Tensor) -> Result<()> {
+    let n = dst.elem_count();
+    if src.elem_count() != n {
+        candle_core::bail!("state of {n} bytes cannot take one of {}", src.elem_count());
+    }
+    let (sg, sl) = src.storage_and_layout();
+    let (dg, dl) = dst.storage_and_layout();
+    let (Storage::Metal(from), Storage::Metal(to)) = (&*sg, &*dg) else {
+        candle_core::bail!("state's bytes live on Metal device");
+    };
+    let mut to = candle_core::MetalStorage::new(Arc::new(to.buffer().clone()), to.device().clone(), n, dst.dtype());
+    from.copy2d(&mut to, 1, n, n, n, sl.start_offset(), dl.start_offset())
+}
+
+/// Every byte of `bytes` set to `value`: one blit fill.
+fn fill(bytes: &Tensor, value: u8) -> Result<()> {
+    let (guard, layout) = bytes.storage_and_layout();
+    let Storage::Metal(ms) = &*guard else {
+        candle_core::bail!("state's bytes live on Metal device");
+    };
+    let blit = ms.device().blit_command_encoder()?;
+    blit.set_label("sequence-state-zero");
+    blit.fill_buffer(ms.buffer(), (layout.start_offset(), bytes.elem_count()), value);
+    blit.end_encoding();
+    Ok(())
+}
