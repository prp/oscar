+/// The last finished chat turns, oldest first: each one's sampled tokens, their text and where its generation
+/// suffix begins; the tokenizer need not write that text as the model did, so a repeated turn takes its own tokens.
+#[derive(Default)]
+pub struct Turns(VecDeque<Turn>);
+
+struct Turn {
+    text: String,
+    toks: Vec<u32>,
+    boundary: usize,
+}
+
+/// The turns kept; a conversation's latest supersedes its earlier ones: this many conversations resume this way.
+const TURNS_KEPT: usize = 8;
+
+impl Turns {
+    /// A finished turn; it supersedes every kept turn it continues.
+    pub fn note(&mut self, text: String, toks: Vec<u32>, boundary: usize) {
+        self.0.retain(|t| !text.starts_with(t.text.as_str()));
+        self.0.push_back(Turn { text, toks, boundary });
+        if self.0.len() > TURNS_KEPT {
+            self.0.pop_front();
+        }
+    }
+
+    /// A chat prompt's tokens with the model's own for the turn it repeats: where `text` begins with a kept turn's
+    /// text and the rest tokenized alone is the render's tail, the turn's tokens stand for its text; else as given.
+    pub fn own_tokens(&self, text: &str, toks: Vec<u32>, tokenizer: &Tokenizer) -> Vec<u32> {
+        let Some(turn) = self
+            .0
+            .iter()
+            .filter(|t| text.starts_with(t.text.as_str()))
+            .max_by_key(|t| t.text.len())
+        else {
+            return toks;
+        };
+        let Ok(rest) = tokenizer.encode_fast(&text[turn.text.len()..], false) else {
+            return toks;
+        };
+        if !toks.ends_with(rest.get_ids()) {
+            return toks;
+        }
+        [turn.toks.as_slice(), rest.get_ids()].concat()
+    }
+
+    /// The diagnostics' line for a chat prompt: whether it keeps the tokens of the kept turn it continues, and where
+    /// the tokenizer's own tokens for the render, `canonical`, would have parted (or part), both sides as ids and text.
+    pub fn say_history(&self, toks: &[u32], canonical: &[u32], tokenizer: &Tokenizer) {
+        let shared = |t: &Turn, s: &[u32]| t.toks.iter().zip(s).take_while(|(a, b)| a == b).count();
+        let Some((turn, at)) = self
+            .0
+            .iter()
+            .map(|t| (t, shared(t, toks)))
+            .filter(|(t, at)| *at >= t.boundary)
+            .max_by_key(|(_, at)| *at)
+        else {
+            return;
+        };
+        let n = turn.toks.len();
+        let say = |ids: &[u32]| {
+            ids.iter()
+                .map(|&t| format!("{t} {:?}", tokenizer.decode(&[t], false).unwrap_or_default()))
+                .join(" ")
+        };
+        let from = |s: &[u32], at: usize| say(&s[at..(at + 8).min(s.len())]);
+        if at == n || at == toks.len() {
+            let own = shared(turn, canonical);
+            if own < at {
+                tracing::info!(
+                    target: "oscar::store",
+                    "history | keeps {at} of turn's {n} tokens, own from {own} where tokenizer writes otherwise | turn: {} | tokenizer: {}",
+                    from(&turn.toks, own),
+                    from(canonical, own),
+                );
+            } else {
+                tracing::info!(target: "oscar::store", "history | keeps {at} of turn's {n} tokens");
+            }
+            return;
+        }
+        tracing::info!(
+            target: "oscar::store",
+            "history | parts from turn's {n} tokens at {at} | shared: {} | turn: {} | history: {}",
+            say(&turn.toks[at.saturating_sub(3)..at]),
+            from(&turn.toks, at),
+            from(toks, at),
+        );
+    }
+}
