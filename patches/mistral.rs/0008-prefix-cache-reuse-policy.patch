+/// engine must prefill at least one token, so a hit covering the whole request degrades or is rejected.
+pub fn usable_hit(
+    has_completion_rec: bool,
+    recurrent_prompt_offset: Option<usize>,
+    match_len: usize,
+    entry_len: usize,
+    request_len: usize,
+) -> Option<usize> {
+    let per_token = !has_completion_rec && recurrent_prompt_offset.is_none();
+    let eff = match recurrent_prompt_offset {
+        _ if per_token || match_len == entry_len => match_len,
+        Some(p) if match_len >= p => p,
+        _ => return None,
+    };
+    match eff {
+        0 => None,
+        eff if eff < request_len => Some(eff),
+        _ if per_token => (request_len > 1).then(|| request_len - 1),
+        _ => recurrent_prompt_offset.filter(|p| *p > 0 && *p < request_len),
+    }
+}
