+// The seam for the durable block-granular KV store: this crate owns the paged KV representation and the cache
+// policy, so the contract lives here and the store is installed at startup; none installed, this file is inert.
+use std::sync::{Arc, OnceLock};
+
+/// One sealed (full, hash-covered) KV block of a sequence, named by its chain hash.
+pub struct SealedBlockMeta {
+    /// Chain hash at this block (commits to the whole prefix through it).
+    pub hash: u64,
+    /// The previous block's chain hash; 0 for a chain root.
+    pub parent: u64,
+    /// Block position in the sequence, 0-based.
+    pub pos: u32,
+    /// The pool block holding the content right now.
+    pub block_id: usize,
+}
+
+/// A boundary record: the partial-block KV rows at a resume-worthy position (the conversation tip, or a hybrid's
+/// prompt boundary) plus the state there. No hash covers a partial block: `tokens` match element-wise above `parent`.
+pub struct TailDeposit {
+    /// Chain hash of the last full block below the boundary; 0 when the boundary sits inside the first block.
+    pub parent: u64,
+    /// Block position the partial rows belong to (= full blocks below the boundary).
+    pub pos: u32,
+    /// The pool block holding the partial rows right now.
+    pub block_id: usize,
+    /// Tokens past the block floor, the element-wise match key; empty for a block-aligned boundary (then state-only).
+    pub tokens: Vec<u32>,
+    /// Recurrent state at the exact boundary; the tip's is the live sequence's own, whose object carries no
+    /// position, so the store takes it from the boundary. `None` for non-hybrids.
+    pub snapshots: Option<RecurrentState>,
+}
+
+/// A durable, block-granular store behind the paged KV pool: deposits stage copies of sealed blocks and a turn's
+/// boundary records (a hybrid's state at each); restores fill a sequence's blocks past its RAM hit at admission.
+pub trait PagedKvStore: Send + Sync {
+    /// Hand the store the block pool's memory and its block layout, once. `hash_probe`, the chain hash of a fixed
+    /// token pattern, fingerprints the hash function, so a store written under another toolchain is swept, not misread.
+    fn bind(
+        &self,
+        memory: Arc<dyn crate::paged_attention::KvBlockMemory>,
+        layout: &crate::paged_attention::KvBlockLayout,
+        hash_probe: u64,
+    );
+
+    /// Deposit a finished sequence's sealed blocks and its boundary records, which supersede
+    /// those of the turns it continues; `toks` is what the records are matched against. The
+    /// store copies device content out here and writes to disk later on its own thread.
+    fn note_finished_sequence(&self, blocks: &[SealedBlockMeta], tails: Vec<TailDeposit>, toks: &[u32]);
+
+    /// Keep the state at a fork (where a prompt parts from a sequence the store holds) for every later prompt
+    /// sharing the beginning: the blocks through it and a state-only record there, which no turn owns.
+    fn note_shared(&self, blocks: &[SealedBlockMeta], record: TailDeposit);
+
+    /// The deepest block of a prompt's `chain` where a held sequence parts from the prompt; `None` where none does.
+    fn fork_depth(&self, chain: &[u64], toks: &[u32]) -> Option<usize>;
+
+    /// Extend a RAM prefix hit of `ram_blocks` blocks (`dst_block_ids[i]` takes chain position `ram_blocks + i`): the
+    /// restored count and snapshot; a matching tail reaches the boundary, a hybrid below only past `ram_state_tokens`.
+    fn restore_extension(
+        &self,
+        chain: &[u64],
+        ram_blocks: usize,
+        dst_block_ids: &[usize],
+        hybrid: bool,
+        ram_state_tokens: usize,
+        toks: &[u32],
+    ) -> Option<(usize, Option<RecurrentState>)>;
+
+    /// Write everything dirty and seal, within `bound`. Called at exit.
+    fn flush(&self, bound: std::time::Duration);
+}
+
+/// Builds a store for a device, or `None` when configured off; called once, when the prefix cache is constructed.
+pub type PagedKvStoreFactory = fn(&Device) -> Option<Arc<dyn PagedKvStore>>;
+
+static FACTORY: OnceLock<PagedKvStoreFactory> = OnceLock::new();
+
+/// Install the store implementation before the first pipeline is built; later calls are ignored.
+pub fn set_paged_kv_store_factory(factory: PagedKvStoreFactory) {
+    let _ = FACTORY.set(factory);
+}
+
+/// Build a store, or `None` when none was installed or it is configured off.
+pub(crate) fn make_paged_kv_store(device: &Device) -> Option<Arc<dyn PagedKvStore>> {
+    FACTORY.get().and_then(|f| f(device))
+}
