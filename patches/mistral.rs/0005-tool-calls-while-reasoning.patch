+static QWEN_PARAM_RE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"(?s)<parameter=(?P<key>[^>\s]+)>(?P<val>.*?)</parameter>").unwrap());
+
+/// The XML tool-call form as the JSON object the matcher already parses. Only the template's one newline either
+/// side of a value comes off: the rest is what the model wrote and the history gives back. Typed JSON where it parses.
+fn parse_qwen_xml_function(inner: &str) -> Option<Value> {
+    let caps = QWEN_FN_RE.captures(inner)?;
+    let mut args = Map::new();
+    for p in QWEN_PARAM_RE.captures_iter(caps.name("body").unwrap().as_str()) {
+        let raw = p.name("val").unwrap().as_str();
+        let raw = raw.strip_prefix('\n').unwrap_or(raw);
+        let raw = raw.strip_suffix('\n').unwrap_or(raw);
+        args.insert(p.name("key").unwrap().as_str().to_string(), json_or_text(raw));
+    }
+    Some(serde_json::json!({
+        "name": caps.name("name").unwrap().as_str(),
+        "arguments": Value::Object(args),
+    }))
+}
+
+static GLM_PAIR_RE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"(?s)<arg_key>(?P<key>.*?)</arg_key>\s*<arg_value>(?P<val>.*?)</arg_value>").unwrap()
+});
+
+/// GLM's tool-call form: the function name as bare text, then `<arg_key>`/`<arg_value>` pairs. It shares Qwen's
+/// outer tag, so the name must look like an identifier or a Qwen-JSON body would parse here. A half call is nothing.
+fn parse_glm_tool_call(inner: &str) -> Option<Value> {
+    let split = inner.find("<arg_key>").unwrap_or(inner.len());
+    let name = inner[..split].trim();
+    if name.is_empty() || !name.chars().all(|c| c.is_alphanumeric() || matches!(c, '_' | '-' | '.')) {
+        return None;
+    }
+    let mut args = Map::new();
+    for c in tiling(&GLM_PAIR_RE, &inner[split..])? {
+        let val = json_or_text(c.name("val").unwrap().as_str());
+        args.insert(c.name("key").unwrap().as_str().trim().to_string(), val);
+    }
+    Some(serde_json::json!({ "name": name, "arguments": Value::Object(args) }))
+}
+
+/// The inverse of the K3 template's `attr()`: `&` as `&amp;`, `"` as `&quot;`.
+fn unescape_kimi_attr(s: &str) -> String {
+    s.replace("&quot;", "\"").replace("&amp;", "&")
+}
+
+static KIMI_ARG_RE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(
+        r#"(?s)<\|open\|>argument key="(?P<key>[^"]*)" type="(?P<ty>[^"]*)"<\|sep\|>(?P<val>.*?)<\|close\|>argument<\|sep\|>"#,
+    )
+    .unwrap()
+});
+static KIMI_JSON_RE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r#"(?s)^<\|open\|>json type="object"<\|sep\|>(?P<raw>.*?)<\|close\|>json<\|sep\|>$"#).unwrap()
+});
+static KIMI_TOOLS_RE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"(?s)<\|open\|>tools<\|sep\|>(?P<body>.*?)<\|close\|>tools<\|sep\|>").unwrap());
+static KIMI_CALL_RE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(
+        r#"(?s)<\|open\|>call tool="(?P<name>[^"]*)" index="[^"]*"<\|sep\|>(?P<inner>.*?)<\|close\|>call<\|sep\|>"#,
+    )
+    .unwrap()
+});
+
+/// The arguments inside one K3 `call` block: `argument` tags (`type` names the JSON type; a string is verbatim,
+/// the rest JSON) or the template's raw `json` fallback block carrying a whole object.
+fn parse_kimi_call_args(inner: &str) -> Option<Value> {
+    let trimmed = inner.trim();
+    if trimmed.is_empty() {
+        return Some(Value::Object(Map::new()));
+    }
+    if let Some(c) = KIMI_JSON_RE.captures(trimmed) {
+        let raw = c.name("raw").unwrap().as_str().trim();
+        return serde_json::from_str::<Value>(raw).ok().filter(|v| v.is_object());
+    }
+    let mut args = Map::new();
+    for c in tiling(&KIMI_ARG_RE, inner)? {
+        let key = unescape_kimi_attr(c.name("key").unwrap().as_str());
+        let val_text = c.name("val").unwrap().as_str();
+        let val = if c.name("ty").unwrap().as_str() == "string" {
+            Value::String(val_text.to_string())
+        } else {
+            serde_json::from_str::<Value>(val_text.trim()).ok()?
+        };
+        args.insert(key, val);
+    }
+    Some(Value::Object(args))
+}
+
+/// Kimi K3 emits tool calls after its answer channel, in tags its template assembles from `<|open|>`/`<|sep|>`/
+/// `<|close|>`. As for GLM, every block complete and contiguous or no call: a truncated stream must not drop arguments.
+fn parse_kimi_tool_calls(message: &str) -> Option<Vec<Value>> {
+    let mut calls = Vec::new();
+    for block in KIMI_TOOLS_RE.captures_iter(message) {
+        for c in tiling(&KIMI_CALL_RE, block.name("body").unwrap().as_str())? {
+            let name = unescape_kimi_attr(c.name("name").unwrap().as_str());
+            if name.trim().is_empty() {
+                return None;
+            }
+            let args = parse_kimi_call_args(c.name("inner").unwrap().as_str())?;
+            calls.push(serde_json::json!({ "name": name, "arguments": args }));
+        }
+    }
+    (!calls.is_empty()).then_some(calls)
+}
