+
+// The seam a harness takes each step's sampled token and logits through; none installed, sampling runs unchanged.
+use std::sync::OnceLock;
+
+pub trait SampleTrace: Send + Sync {
+    /// Asked first: keeping a handle on the step's logits costs a clone.
+    fn records_step_logits(&self) -> bool {
+        false
+    }
+
+    /// `Some(forced)` under teacher-forced replay: the caller adds `forced` in place of the token it
+    /// sampled. `prompt` marks the prompt step's sample, the generation's step 0.
+    fn note_step_logits(&self, _sampled: u32, _logits: &Tensor, _prompt: bool) -> Option<u32> {
+        None
+    }
+
+    /// Whether the trace forces tokens: a device-sampled step then drains at its boundary, since a
+    /// queued step's token has fed the next forward before the host reads it.
+    fn forces_tokens(&self) -> bool {
+        false
+    }
+}
+
+/// The installed trace while it records each step's logits.
+pub fn logit_trace() -> Option<&'static Arc<dyn SampleTrace>> {
+    global_sample_trace().filter(|t| t.records_step_logits())
+}
+
+static GLOBAL_TRACE: OnceLock<Arc<dyn SampleTrace>> = OnceLock::new();
+
+/// First caller wins; intended for model-load time, before the first step.
+pub fn set_global_sample_trace(trace: Arc<dyn SampleTrace>) {
+    let _ = GLOBAL_TRACE.set(trace);
+}
+
+pub fn global_sample_trace() -> Option<&'static Arc<dyn SampleTrace>> {
+    GLOBAL_TRACE.get()
+}
