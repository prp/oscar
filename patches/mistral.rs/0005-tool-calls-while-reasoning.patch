+/// `re`'s matches when they tile `body` with nothing but whitespace between and around them: a truncated
+/// stream leaves a dangling key or an unclosed value, and a call with arguments dropped is worse than none.
+fn tiling<'a>(re: &Regex, body: &'a str) -> Option<Vec<regex::Captures<'a>>> {
+    let mut end = 0;
+    let mut out = Vec::new();
+    for c in re.captures_iter(body) {
+        let m = c.get(0).unwrap();
+        if !body[end..m.start()].trim().is_empty() {
+            return None;
+        }
+        end = m.end();
+        out.push(c);
+    }
+    body[end..].trim().is_empty().then_some(out)
+}
+
+/// A value as the model wrote it: typed JSON where it parses, text otherwise.
+fn json_or_text(raw: &str) -> Value {
+    serde_json::from_str::<Value>(raw.trim()).unwrap_or_else(|_| Value::String(raw.to_string()))
+}
+
+static QWEN_FN_RE: LazyLock<Regex> =
