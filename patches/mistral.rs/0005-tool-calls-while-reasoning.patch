+/// The tag parser classifies calls inside a think block as reasoning, so a content-only parse would drop them.
+/// Content first, then the think block, then the raw completion for grammars placing calls outside both (Kimi K3).
+pub fn parse_tools_from_reasoning_output(
+    content: Option<&str>,
+    reasoning: Option<&str>,
+    raw: Option<&str>,
+    matcher: Option<Arc<ToolCallingMatcher>>,
+) -> anyhow::Result<(Option<String>, Vec<ToolCallResponse>)> {
+    let kept = content.map(str::to_string);
+    let Some(matcher) = matcher else {
+        return Ok((kept, Vec::new()));
+    };
+    for (channel, keep_content) in [(content, false), (reasoning, true), (raw, true)] {
+        let calls = channel.map(|c| matcher.get_call(c)).transpose()?.unwrap_or_default();
+        if !calls.is_empty() {
+            return Ok((kept.filter(|_| keep_content), calls));
+        }
+    }
+    Ok((kept, Vec::new()))
+}
