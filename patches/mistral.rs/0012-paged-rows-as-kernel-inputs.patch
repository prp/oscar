+    /// A step's paged rows on the host, one entry a sequence: the slot each new token's K/V is written
+    /// to, the keys each new token sees, and the block table they resolve through.
+    #[derive(Default)]
+    pub struct PagedRows {
+        pub slot_mappings: Vec<Vec<i64>>,
+        pub context_lens: Vec<Vec<usize>>,
+        pub block_tables: Vec<Vec<usize>>,
+    }
+
+    impl PagedRows {
+        /// One sequence's new tokens at `positions` of its context, through its block table: each writes its
+        /// own slot and sees every key up to itself, the kernel's per-row causal mask following these counts.
+        pub fn push(
+            &mut self,
+            table: Vec<usize>,
+            positions: std::ops::Range<usize>,
+            block_size: usize,
+        ) {
+            let slots = positions.clone().map(|i| {
+                let Some(block) = table.get(i / block_size) else {
+                    panic!(
+                        "Block table is too small (prompt)! i={i} block_size={block_size} table_len={}",
+                        table.len()
+                    );
+                };
+                block
+                    .checked_mul(block_size)
+                    .and_then(|v| v.checked_add(i % block_size))
+                    .expect("Slot calculation overflowed")
+                    .try_into()
+                    .expect("Slot value too large for target integer type")
+            });
+            self.slot_mappings.push(slots.collect());
+            self.context_lens.push(positions.map(|i| i + 1).collect());
+            self.block_tables.push(table);
+        }
+
+        /// The largest VISIBLE context: the kernel's partitioning is sized from
+        /// what attention spans, not from how many new tokens the step carries.
+        fn max_context_len(&self) -> usize {
+            let last = self.context_lens.iter().filter_map(|x| x.last().copied());
+            last.max().unwrap_or(0)
+        }
+
+        /// The block tables (a row a sequence) and the visible-key counts end to end, on the host, padded with 0.
+        fn tables_and_lens(&self) -> Result<(Tensor, Tensor)> {
+            let padded = |rows: &[Vec<usize>]| -> Result<(Tensor, usize)> {
+                let len = rows.iter().map(Vec::len).max();
+                let len = len.expect("a paged step has a sequence with allocated blocks");
+                let rows = rows
+                    .iter()
+                    .map(|x| x.iter().map(|x| *x as u32).collect())
+                    .collect();
+                Ok((_make_tensor_with_pad::<u32>(rows, len, 0, &Device::Cpu)?, len))
+            };
+            let (tables, table_len) = padded(&self.block_tables)?;
+            let (lens, _) = padded(&self.context_lens)?;
+            Ok((tables.reshape(((), table_len))?, lens.reshape(((),))?))
+        }
+
+        /// The one builder of a step's paged tensors: a prompt chunk, a decode step and the load's oscar records all
+        /// come through here, so slots, tables and counts are one fact, made on the host and copied once per device.
+        fn upload(&self, devices: &[Device]) -> Result<[PerDevice; 3]> {
+            let width = self.slot_mappings.iter().map(Vec::len).max();
+            let slots = _make_tensor_with_pad(
+                self.slot_mappings.clone(),
+                width.expect("a paged step has a sequence"),
+                _PAD_SLOT_ID,
+                &Device::Cpu,
+            )?;
+            let (tables, lens) = self.tables_and_lens()?;
+            let mut maps: [PerDevice; 3] = Default::default();
+            for device in devices {
+                let loc = device.location();
+                maps[0].insert(loc.clone(), slots.to_device(device)?);
+                maps[1].insert(loc.clone(), tables.to_device(device)?);
+                maps[2].insert(loc, lens.to_device(device)?);
+            }
+            Ok(maps)
+        }
+
+        /// A prompt chunk's paged inputs.
+        pub fn prompt_chunk(
+            &self,
+            first: bool,
+            devices: &[Device],
+        ) -> Result<PagedAttentionInputMetadata> {
+            let [slot_mappings, block_tables, context_lens] = self.upload(devices)?;
+            Ok(PagedAttentionInputMetadata {
+                slot_mappings,
+                block_tables: Some(block_tables),
+                context_lens: Some(context_lens),
+                max_context_len: Some(self.max_context_len()),
+                full_block_tables: None,
+                full_context_lens: None,
+                full_max_context_len: None,
+                is_first_prompt_chunk: first,
+                paged_kv_indptr: None,
+                paged_kv_indices: None,
+                paged_kv_last_page_len: None,
+                paged_kv_request_indices: None,
+                paged_kv_tile_indices: None,
+                paged_kv_o_indptr: None,
+                paged_kv_chunk_size: None,
+                num_cached_tokens: None,
+                query_lens: None,
+                cu_seqlens_q: None,
+                cu_seqlens_kv: None,
+            })
+        }
+
+        /// A decode step's: a chunk's, with the full (unwindowed) view beside them (the same tensors where no
+        /// window slides) and the CUDA decode path's flashinfer-style indices where that path exists.
+        pub fn decode_step(
+            &self,
+            unwindowed: Option<&PagedRows>,
+            block_size: usize,
+            devices: &[Device],
+        ) -> Result<PagedAttentionInputMetadata> {
+            let mut meta = self.prompt_chunk(false, devices)?;
+            (meta.full_block_tables, meta.full_context_lens) = match unwindowed {
+                Some(full) => {
+                    let (tables, lens) = full.tables_and_lens()?;
+                    (Some(on_each(&tables, devices)?), Some(on_each(&lens, devices)?))
+                }
+                None => (meta.block_tables.clone(), meta.context_lens.clone()),
+            };
+            meta.full_max_context_len = Some(unwindowed.unwrap_or(self).max_context_len());
+            if cfg!(all(feature = "cuda", target_family = "unix")) {
+                let lens: Vec<usize> = self.context_lens.iter().map(|x| x[0]).collect();
+                let [indptr, indices, last_page_len, request_indices, tile_indices, o_indptr, chunk_size] =
+                    paged_kv_indices(&self.block_tables, &lens, block_size)?
+                        .map(|t| on_each(&t, devices));
+                meta.paged_kv_indptr = Some(indptr?);
+                meta.paged_kv_indices = Some(indices?);
+                meta.paged_kv_last_page_len = Some(last_page_len?);
+                meta.paged_kv_request_indices = Some(request_indices?);
+                meta.paged_kv_tile_indices = Some(tile_indices?);
+                meta.paged_kv_o_indptr = Some(o_indptr?);
+                meta.paged_kv_chunk_size = Some(chunk_size?);
+            }
+            Ok(meta)
+        }
+    }
