+    /// The CUDA decode path's flashinfer-style view of a step's block tables, as host tensors: indptr,
+    /// indices, last-page lengths, request and tile indices, the output indptr and the chunk size.
+    fn paged_kv_indices(
+        block_tables: &[Vec<usize>],
+        context_lens: &[usize],
+        block_size: usize,
+    ) -> Result<[Tensor; 7]> {
+        let batch_size = block_tables.len();
+        let mut indices = Vec::new();
+        let mut indptr = Vec::with_capacity(batch_size + 1);
+        let mut last_page_len = Vec::with_capacity(batch_size);
+        indptr.push(0i32);
+        let mut nnz_pages = 0i32;
+        for (table, context_len) in block_tables.iter().zip(context_lens) {
+            let num_blocks = table.len();
+            nnz_pages += num_blocks as i32;
+            indptr.push(nnz_pages);
+            indices.extend(table.iter().map(|x| *x as i32));
+            let consumed = num_blocks.saturating_sub(1) * block_size;
+            if num_blocks > 0 && *context_len < consumed {
+                panic!(
+                    "paged kv context len underflow: context_len={} consumed={}",
+                    context_len, consumed
+                );
+            }
+            last_page_len.push(if num_blocks == 0 { 0 } else { (*context_len - consumed) as i32 });
+        }
+        let request_indices: Vec<i32> = (0..batch_size as i32).collect();
+        let o_indptr: Vec<i32> = (0..=batch_size as i32).collect();
+        Ok([
+            Tensor::from_vec(indptr, (batch_size + 1,), &Device::Cpu)?,
+            Tensor::from_vec(indices, (nnz_pages as usize,), &Device::Cpu)?,
+            Tensor::from_vec(last_page_len, (batch_size,), &Device::Cpu)?,
+            Tensor::from_vec(request_indices, (batch_size,), &Device::Cpu)?,
+            Tensor::from_vec(vec![0i32; batch_size], (batch_size,), &Device::Cpu)?,
+            Tensor::from_vec(o_indptr, (batch_size + 1,), &Device::Cpu)?,
+            Tensor::from_vec(vec![block_size as i32], (1,), &Device::Cpu)?,
+        ])
+    }
