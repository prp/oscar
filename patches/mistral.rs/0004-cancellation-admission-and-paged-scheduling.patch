+/// A sequence's chain of block hashes over its tokens.
+fn block_hashes(seq: &Sequence, block_size: usize) -> Vec<BlockHash> {
+    compute_block_hashes(seq.get_toks(), block_size, seq.mm_features(), &[])
+}
+
+/// The chain as the store is asked by.
+fn chain(hashes: &[BlockHash]) -> Vec<u64> {
+    hashes.iter().map(BlockHash::value).collect()
+}
+
+/// Keeps a sequence's blocks under `keep` tokens and takes fresh ones for the rest; false when the pool refuses.
+fn rewind_blocks(kv: &Arc<Mutex<KVCacheManager>>, seq: &Sequence, keep: usize) -> bool {
+    let mut kv = get_mut_arcmutex!(kv);
+    kv.trim_request_to_num_tokens(*seq.id(), keep);
+    kv.allocate_slots(*seq.id(), seq.get_toks().len(), &[]).is_some()
+}
+
+/// The first `n` blocks as the store names them: each by its chain hash, its parent's and its pool block.
+fn sealed_blocks(hashes: &[BlockHash], ids: &[usize], n: usize) -> Vec<SealedBlockMeta> {
+    (0..n)
+        .map(|i| SealedBlockMeta {
+            hash: hashes[i].value(),
+            parent: if i == 0 { 0 } else { hashes[i - 1].value() },
+            pos: i as u32,
+            block_id: ids[i],
+        })
+        .collect()
+}
