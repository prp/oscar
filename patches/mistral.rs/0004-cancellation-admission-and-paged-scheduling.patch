+/// Forwards one prefill chunk without sampling, leaving the sequence ready to continue at `chunk_end`.
+fn prefill_one_chunk(
+    pipeline: &mut dyn Pipeline,
+    seq: &mut Sequence,
+    chunk_end: usize,
+    paged_attn: PagedAttentionMeta,
+) -> Result<Duration, candle_core::Error> {
+    let offset = seq.token_offset();
+    let remaining = seq.get_toks().to_vec();
+    let chunk_len = chunk_end - offset;
+    if chunk_len == 0 || chunk_len >= remaining.len() {
+        candle_core::bail!(
+            "prefill split: chunk_end {chunk_end} out of range (offset {offset}, {} remaining)",
+            remaining.len()
+        );
+    }
+    let (chunk, tail) = remaining.split_at(chunk_len);
+    let tail = tail.to_vec();
+    seq.set_prefill_toks(chunk.to_vec());
+    // A paged prefix hit leaves the offset at 0 and skips its cached tokens by `prefix_cache_len` instead.
+    let forwarded = seq.step_tokens();
+    crate::paged_attention::note_step_kind(&crate::paged_attention::StepKind {
+        prompt: true,
+        tokens: forwarded,
+        device: &pipeline.device(),
+        drop_state_indices: &|| {
+            if pipeline.cache().is_hybrid() {
+                pipeline.cache().hybrid().set_state_indices(None);
+            }
+        },
+    })?;
+    let result = (|| {
+        // The paged step installs the recurrent state indices itself; a chunk forward bypasses it,
+        // so a hybrid model's recurrent layers would write another request's slot without this.
+        pipeline.set_recurrent_state_indices(std::slice::from_ref(&seq));
+        let inputs = pipeline
+            .get_processor()
+            .inputs_processor()
+            .process_inputs(
+                pipeline.tokenizer(),
+                &mut [seq],
+                true,
+                pipeline.get_metadata().is_xlora,
+                &pipeline.device(),
+                pipeline.get_metadata().no_kv_cache,
+                None,
+                false,
+                pipeline.get_metadata().sliding_window,
+                pipeline.get_input_processor_config(),
+                Some(paged_attn),
+                pipeline.device_mapper(),
+            )
+            .map_err(candle_core::Error::msg)?
+            .inputs;
+        let start = Instant::now();
+        {
+            let _round = ROUND.get().map(|round| round.chunk());
+            pipeline.forward_inputs(inputs, false)?;
+        }
+        Ok(start.elapsed())
+    })();
+
+    match result {
+        Ok(exec) => {
+            crate::live::prompt_tokens(forwarded as u64);
+            // The suffix goes to the normal prompt step, continuing at `chunk_end` over the cache just filled.
+            seq.set_prefill_toks(tail);
+            seq.set_token_offset(chunk_end);
+            Ok(exec)
+        }
+        Err(e) => {
+            // Restore the token view; the caller surfaces the error (a half-advanced state cannot rewind).
+            let mut restore = seq.get_toks().to_vec();
+            restore.extend_from_slice(&tail);
+            if offset == 0 {
+                seq.reset_prefill_toks();
+            } else {
+                seq.set_prefill_toks(restore);
+            }
+            Err(e)
+        }
+    }
+}
