+
+/// The one relaxed check the engine pays per token or chunk boundary.
+pub(crate) fn memory_crossing_pending() -> bool {
+    MEMORY_CROSSING_PENDING.load(Ordering::Relaxed)
+}
+
+pub(crate) fn run_memory_crossing(dev: &Device) {
+    if MEMORY_CROSSING_PENDING.swap(false, Ordering::AcqRel) {
+        if let Some(hook) = MEMORY_CROSSING_HOOK.get() {
+            hook(dev);
+        }
+    }
