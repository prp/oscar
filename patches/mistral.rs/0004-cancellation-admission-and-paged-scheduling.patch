+use std::sync::OnceLock;
+
+/// The interior chunk ends of one prefill: only a memory budget knows where to cut; none, a single forward.
+pub trait PrefillChunkPolicy: Send + Sync {
+    /// Interior ends in order; the final chunk is the caller's.
+    fn chunk_ends(&self, offset: usize, end: usize) -> Vec<usize>;
+}
+
+static POLICY: OnceLock<Arc<dyn PrefillChunkPolicy>> = OnceLock::new();
+
+/// First caller wins; intended for model-load time.
+pub fn set_prefill_chunk_policy(policy: Arc<dyn PrefillChunkPolicy>) {
+    let _ = POLICY.set(policy);
+}
+
+/// A step around the pipeline's own (the caller's decode strategy) and a guard across each chunk's forward.
+#[async_trait::async_trait]
+pub trait StepRound: Send + Sync {
+    #[allow(clippy::too_many_arguments)]
+    async fn step(
+        &self,
+        pipeline: &mut dyn Pipeline,
+        input_seqs: &mut [&mut crate::sequence::Sequence],
+        is_prompt: bool,
+        return_raw_logits: bool,
+        prefix_cacher: &mut PrefixCacheManagerV2,
+        disable_eos_stop: bool,
+        rng: Arc<std::sync::Mutex<Isaac64Rng>>,
+        backend_metadata: crate::CacheBackendMetadata,
+    ) -> Result<Duration, candle_core::Error>;
+    /// Held across one prefill chunk's forward.
+    fn chunk(&self) -> Box<dyn std::any::Any>;
+}
+
+static ROUND: OnceLock<Arc<dyn StepRound>> = OnceLock::new();
+
+/// First caller wins; intended for model-load time.
+pub fn set_step_round(round: Arc<dyn StepRound>) {
+    let _ = ROUND.set(round);
+}
+
+/// The engine's step: the installed round's, else the pipeline's own.
+#[allow(clippy::too_many_arguments)]
+/// The sequence's recurrent state from the state memory, where the model has one: a full memory releases retained
+/// snapshots first (a rung is a cache entry, a request is not); none left refuses.
+fn seat_recurrent(
+    pipeline: &dyn crate::pipeline::Pipeline,
+    prefix_cacher: &Arc<Mutex<crate::prefix_cacher::PrefixCacheManagerV2>>,
+    seq: &mut crate::sequence::Sequence,
+) -> Result<(), candle_core::Error> {
+    if pipeline.get_metadata().no_kv_cache || !pipeline.cache().is_hybrid() {
+        return Ok(());
+    }
+    let slot = loop {
+        let taken = pipeline.cache().hybrid().allocate_seq();
+        if taken.is_ok() || !get_mut_arcmutex!(prefix_cacher).release_paged_recurrent() {
+            break taken?;
+        }
+    };
+    seq.set_recurrent_state_idx(slot);
+    Ok(())
+}
+
+async fn engine_step(
+    pipeline: &mut dyn Pipeline,
+    input_seqs: &mut [&mut crate::sequence::Sequence],
+    is_prompt: bool,
+    return_raw_logits: bool,
+    prefix_cacher: &mut PrefixCacheManagerV2,
+    disable_eos_stop: bool,
+    rng: Arc<std::sync::Mutex<Isaac64Rng>>,
+    backend_metadata: crate::CacheBackendMetadata,
+) -> Result<Duration, candle_core::Error> {
+    match ROUND.get() {
+        Some(r) => r.step(pipeline, input_seqs, is_prompt, return_raw_logits, prefix_cacher, disable_eos_stop, rng, backend_metadata).await,
+        None => pipeline.step(input_seqs, is_prompt, return_raw_logits, prefix_cacher, disable_eos_stop, rng, backend_metadata).await,
+    }
+}
+
+/// The installed policy's ends; none without one.
+pub fn prefill_chunk_ends(offset: usize, end: usize) -> Vec<usize> {
+    POLICY.get().map_or_else(Vec::new, |policy| policy.chunk_ends(offset, end))
+}
+
+/// Deposit-bearing chunk ends for a paged hybrid prompt: the policy's cuts aligned down to block
+/// multiples, so each chunk's state sits where a later block-granular match can land.
+pub fn paged_deposit_cuts(offset: usize, end: usize, block_size: usize, cuts: Vec<usize>) -> Vec<usize> {
+    let mut cuts: Vec<usize> = cuts.iter().map(|c| c - c % block_size).filter(|c| *c > offset && *c < end).collect();
+    cuts.sort_unstable();
+    cuts.dedup();
+    cuts
+}
+
+/// An autorelease pool that drains when the scope ends, on every exit path.
+#[cfg(feature = "metal")]
+struct AutoreleaseScope(*mut std::ffi::c_void);
+
+#[cfg(feature = "metal")]
+impl AutoreleaseScope {
+    fn push() -> Self {
+        // SAFETY: push/pop pair on this thread in LIFO order; the scope is never sent across threads.
+        Self(unsafe { objc2::ffi::objc_autoreleasePoolPush() })
+    }
+}
+
+#[cfg(feature = "metal")]
+impl Drop for AutoreleaseScope {
+    fn drop(&mut self) {
+        // SAFETY: the token came from `push` on this thread.
+        unsafe { objc2::ffi::objc_autoreleasePoolPop(self.0) }
+    }
+}
