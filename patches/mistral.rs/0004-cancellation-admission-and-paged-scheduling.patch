new file mode 100644
index 00000000..ca47857d
--- /dev/null
+++ w/mistralrs-core/src/paged_attention/kv_memory.rs
@@ -0,0 +1,141 @@
+//! The KV pool's memory, supplied from outside the engine: one object per block, block-major (every
+//! layer's K row then V row), reached by the kernels through address tables indexed by block id.
+
+use std::sync::{Arc, OnceLock};
+
+use candle_core::{DType, Device, Result, Tensor};
+
+use super::config::{KvCacheLayout, ModelConfigLike};
+
+/// One layer's two rows inside a block: their dims and byte offsets.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LayerRows {
+    /// The K row: `[kv_heads, head_size / x, block_size, x]`; a latent row `[block_size, kv_lora_rank]`.
+    pub k: Vec<usize>,
+    /// The V row: `[kv_heads, head_size, block_size]`; latent `[block_size, kpe_head_dim]` (empty for NoPE).
+    pub v: Vec<usize>,
+    pub k_offset: usize,
+    pub v_offset: usize,
+}
+
+/// One block's bytes, row by row, in the cache dtype: what the memory allocates and a store writes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct KvBlockLayout {
+    pub block_size: usize,
+    pub dtype: DType,
+    /// Every model layer in order; `None` for a layer that stores no KV.
+    pub rows: Vec<Option<LayerRows>>,
+}
+
+impl KvBlockLayout {
+    /// The layout the model's configuration implies at `block_size`.
+    pub fn of(model: &dyn ModelConfigLike, block_size: usize, dtype: DType) -> Self {
+        let es = dtype.size_in_bytes();
+        let x = 16 / es;
+        let mut offset = 0usize;
+        let rows = (0..model.num_layers())
+            .map(|layer| {
+                if !model.kv_bearing_layer(layer) {
+                    return None;
+                }
+                let (k, v) = match model.kv_cache_layout() {
+                    KvCacheLayout::Standard => (
+                        vec![
+                            model.num_kv_heads_for_layer(layer),
+                            model.k_head_dim_for_layer(layer) / x,
+                            block_size,
+                            x,
+                        ],
+                        vec![
+                            model.num_kv_heads_for_layer(layer),
+                            model.v_head_dim_for_layer(layer),
+                            block_size,
+                        ],
+                    ),
+                    KvCacheLayout::Mla { kv_lora_rank, kpe_head_dim } => {
+                        (vec![block_size, kv_lora_rank], vec![block_size, kpe_head_dim])
+                    }
+                };
+                let k_offset = offset;
+                offset += k.iter().product::<usize>() * es;
+                let v_offset = offset;
+                offset += v.iter().product::<usize>() * es;
+                Some(LayerRows { k, v, k_offset, v_offset })
+            })
+            .collect();
+        Self { block_size, dtype, rows }
+    }
+
+    /// A block's bytes: every layer's rows, K then V, in layer order.
+    pub fn block_bytes(&self) -> usize {
+        let es = self.dtype.size_in_bytes();
+        self.rows
+            .iter()
+            .flatten()
+            .map(|r| (r.k.iter().product::<usize>() + r.v.iter().product::<usize>()) * es)
+            .sum()
+    }
+
+    /// The KV-bearing layers: (layer index, its rows).
+    pub fn kv_layers(&self) -> impl Iterator<Item = (usize, &LayerRows)> {
+        self.rows.iter().enumerate().filter_map(|(i, r)| r.as_ref().map(|r| (i, r)))
+    }
+}
+
+/// The memory behind the block pool. `layer_tables` gives every layer its K and V tables of one
+/// `i64` GPU address per block (null where absent), `block` a block's bytes as a tensor for a
+/// store's or drafter's copies; `take` and `release` move blocks between present and absent.
+pub trait KvBlockMemory: Send + Sync {
+    /// The index space, in blocks.
+    fn blocks(&self) -> usize;
+    /// The blocks present now.
+    fn live_blocks(&self) -> usize;
+    /// Per layer, the K and V address tables (`[blocks]` I64); a layer without KV gets one null entry.
+    fn layer_tables(&self) -> Vec<(Tensor, Tensor)>;
+    /// Block `id`'s bytes, `[block_bytes / dtype size]` in the cache dtype.
+    fn block(&self, id: usize) -> Result<Tensor>;
+    fn take(&self, ids: &[usize]) -> Result<()>;
+    fn release(&self, ids: &[usize]) -> Result<()>;
+}
+
+/// Builds the memory for a layout on a device, once per process.
+pub type KvMemoryFactory =
+    Box<dyn Fn(&Device, &KvBlockLayout) -> Result<Arc<dyn KvBlockMemory>> + Send + Sync>;
+
+static FACTORY: OnceLock<KvMemoryFactory> = OnceLock::new();
+static LAYOUT: OnceLock<KvBlockLayout> = OnceLock::new();
+
+/// Install the memory's factory before the first pipeline is built; later calls are ignored.
+pub fn set_kv_memory_factory(factory: KvMemoryFactory) {
+    let _ = FACTORY.set(factory);
+}
+
+/// The memory for `layout`, through the installed factory; the layout is the process's from here on.
+pub(crate) fn make_kv_memory(device: &Device, layout: &KvBlockLayout) -> Result<Arc<dyn KvBlockMemory>> {
+    let Some(factory) = FACTORY.get() else {
+        candle_core::bail!("paged attention: no KV block memory installed");
+    };
+    let memory = factory(device, layout)?;
+    set_kv_layout(layout.clone());
+    Ok(memory)
+}
+
+/// Install the kernels' block layout (the factory path does; a kernel test does it itself). First wins.
+pub fn set_kv_layout(layout: KvBlockLayout) {
+    let _ = LAYOUT.set(layout);
+}
+
+/// The process's block layout.
+pub fn kv_layout() -> &'static KvBlockLayout {
+    LAYOUT.get().expect("paged attention: the KV block layout is set when the block pool is built")
+}
+
+/// The block size in tokens.
+pub fn block_size() -> usize {
+    kv_layout().block_size
+}
+
+/// The cache dtype.
+pub fn cache_dtype() -> DType {
+    kv_layout().dtype
+}
