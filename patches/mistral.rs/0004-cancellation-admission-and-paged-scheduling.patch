+/// Where a hybrid prompt's prefill deposits the recurrent states it yields, and the keys they are filed under.
+struct Deposits {
+    slot: usize,
+    block_size: usize,
+    hashes: Vec<BlockHash>,
+    store: Option<Arc<dyn PagedKvStore>>,
+    /// The template-suffix boundary, the prompt record's position; only under a store.
+    state_cut: Option<usize>,
+    /// Where the prompt parts from a sequence the store holds.
+    fork_cut: Option<usize>,
+    /// The boundary's block floor, the prompt record's stand-in without a store.
+    floor: Option<usize>,
+}
+
+impl Deposits {
+    /// The state positions inside the prompt, in order, each once.
+    fn points(&self) -> Vec<usize> {
+        let mut points: Vec<usize> = [self.state_cut, self.fork_cut, self.floor].into_iter().flatten().collect();
+        points.sort_unstable();
+        points.dedup();
+        points
+    }
+}
