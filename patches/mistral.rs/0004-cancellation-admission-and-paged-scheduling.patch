+
+/// A memory-axis crossing: the runtime asks, the engine runs the hook on its own thread at the next
+/// token or chunk boundary, handing it the device to drain the stream first. Pool and sequences stay.
+static MEMORY_CROSSING_HOOK: OnceLock<Box<dyn Fn(&Device) + Send + Sync>> = OnceLock::new();
+static MEMORY_CROSSING_PENDING: AtomicBool = AtomicBool::new(false);
+/// The engine loop's wake handle, so a request lands while it idles.
+static ENGINE_WAKER: OnceLock<Arc<tokio::sync::Notify>> = OnceLock::new();
+
+pub fn set_memory_crossing_hook(hook: Box<dyn Fn(&Device) + Send + Sync>) {
+    let _ = MEMORY_CROSSING_HOOK.set(hook);
+}
+
+pub fn request_memory_crossing() {
+    MEMORY_CROSSING_PENDING.store(true, Ordering::Release);
+    if let Some(n) = ENGINE_WAKER.get() {
