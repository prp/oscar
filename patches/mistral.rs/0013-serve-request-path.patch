+//! What the engine is doing now, for a status line beside it: the phase of the step being run, when it began, the
+//! prompt and completion tokens processed; a chunk counts when it lands, its routed layers stamping progress first.
+
+use std::sync::atomic::{AtomicU64, AtomicU8, Ordering::Relaxed};
+use std::sync::OnceLock;
+use std::time::Instant;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Phase {
+    Idle = 0,
+    Prefill = 1,
+    Decode = 2,
+}
+
+static PHASE: AtomicU8 = AtomicU8::new(0);
+static COMPLETION: AtomicU64 = AtomicU64::new(0);
+static PROMPT: AtomicU64 = AtomicU64::new(0);
+static BEGAN_NS: AtomicU64 = AtomicU64::new(0);
+static BEGAN_COMPLETION: AtomicU64 = AtomicU64::new(0);
+static BEGAN_PROMPT: AtomicU64 = AtomicU64::new(0);
+/// The prompt chunk in flight: its tokens, the routed layers that have run it, and the routed layers a
+/// chunk runs (set at load, re-learned from each chunk that lands).
+static CHUNK_TOKENS: AtomicU64 = AtomicU64::new(0);
+static CHUNK_LAYERS_DONE: AtomicU64 = AtomicU64::new(0);
+static CHUNK_LAYERS: AtomicU64 = AtomicU64::new(0);
+static EPOCH: OnceLock<Instant> = OnceLock::new();
+
+fn now_ns() -> u64 {
+    EPOCH.get_or_init(Instant::now).elapsed().as_nanos() as u64
+}
+
+/// A phase change stamps when the new phase began and the counts it began at, and leaves no chunk in flight.
+pub(crate) fn set_phase(p: Phase) {
+    if PHASE.swap(p as u8, Relaxed) != p as u8 {
+        BEGAN_NS.store(now_ns(), Relaxed);
+        BEGAN_COMPLETION.store(COMPLETION.load(Relaxed), Relaxed);
+        BEGAN_PROMPT.store(PROMPT.load(Relaxed), Relaxed);
+        CHUNK_TOKENS.store(0, Relaxed);
+        CHUNK_LAYERS_DONE.store(0, Relaxed);
+    }
+}
+
+pub(crate) fn completion_token() {
+    COMPLETION.fetch_add(1, Relaxed);
+}
+
+/// A prompt chunk of `n` tokens landed: the layers it ran are the count a chunk runs from now on; nothing in flight.
+pub(crate) fn prompt_tokens(n: u64) {
+    PROMPT.fetch_add(n, Relaxed);
+    let done = CHUNK_LAYERS_DONE.swap(0, Relaxed);
+    if done > 0 {
+        CHUNK_LAYERS.store(done, Relaxed);
+    }
+    CHUNK_TOKENS.store(0, Relaxed);
+}
+
+/// The routed layers a prompt chunk runs, from the model's layout at load; a chunk that lands corrects it.
+pub fn set_prompt_layers(n: u64) {
+    CHUNK_LAYERS.store(n, Relaxed);
+}
+
+/// One routed layer of a prompt chunk of `tokens` tokens has run. Counted only in the prefill phase, so
+/// a drafter's or a census's multi-token forward stamps nothing.
+pub fn prompt_layer(tokens: u64) {
+    if PHASE.load(Relaxed) != Phase::Prefill as u8 {
+        return;
+    }
+    CHUNK_TOKENS.store(tokens, Relaxed);
+    CHUNK_LAYERS_DONE.fetch_add(1, Relaxed);
+}
+
+/// The engine now: its phase, the seconds it has run, the prompt and completion tokens processed since it began (the
+/// prompt count carrying the chunk in flight at the share of its layers run) and the completion tokens since launch.
+#[derive(Clone, Copy, Debug)]
+pub struct Live {
+    pub phase: Phase,
+    pub secs: f64,
+    pub prompt: u64,
+    pub completion: u64,
+    pub completion_total: u64,
+}
+
+pub fn now() -> Live {
+    let phase = match PHASE.load(Relaxed) {
+        1 => Phase::Prefill,
+        2 => Phase::Decode,
+        _ => Phase::Idle,
+    };
+    let completion_total = COMPLETION.load(Relaxed);
+    let in_flight = match (CHUNK_TOKENS.load(Relaxed), CHUNK_LAYERS_DONE.load(Relaxed), CHUNK_LAYERS.load(Relaxed)) {
+        (tokens, done, layers) if layers > 0 => tokens * done.min(layers) / layers,
+        _ => 0,
+    };
+    Live {
+        phase,
+        secs: now_ns().saturating_sub(BEGAN_NS.load(Relaxed)) as f64 / 1e9,
+        prompt: PROMPT.load(Relaxed).saturating_sub(BEGAN_PROMPT.load(Relaxed)) + in_flight,
+        completion: completion_total.saturating_sub(BEGAN_COMPLETION.load(Relaxed)),
+        completion_total,
+    }
+}
+
+/// How long something took, as every console line says it: seconds from one second up, whole milliseconds
+/// below, a time under a millisecond with its tenth; never a `0 ms` for a time that was not nothing.
+pub fn duration_text(secs: f64) -> String {
+    let ms = secs * 1e3;
+    // Each threshold is where the finer form would round up to the next one.
+    if ms >= 999.5 {
+        format!("{secs:.1} s")
+    } else if ms >= 0.95 {
+        format!("{ms:.0} ms")
+    } else if ms >= 0.05 {
+        format!("{ms:.1} ms")
+    } else if ms > 0.0 {
+        "<0.1 ms".to_string()
+    } else {
+        "0 ms".to_string()
+    }
+}
