+static ADVERTISED: OnceLock<Vec<(String, Option<bool>)>> = OnceLock::new();
+
+/// Declare the ids this server advertises for the model it loaded, each with the generation mode
+/// its name carries (`None` = whatever the request asks). The embedder owns these, and registers
+/// each as an alias of the loaded model so they route and validate on every endpoint.
+pub fn set_advertised_models(ids: Vec<(String, Option<bool>)>) {
+    let _ = ADVERTISED.set(ids);
+}
+
+static EPILOGUE: OnceLock<Box<dyn Fn() -> Option<String> + Send + Sync>> = OnceLock::new();
+
+/// Install a second line for the per-request record, printed after each completed request: what a request cost
+/// below the API only the runtime underneath knows. `None` prints nothing.
+pub fn set_request_epilogue(line: Box<dyn Fn() -> Option<String> + Send + Sync>) {
+    let _ = EPILOGUE.set(line);
+}
+
+/// The epilogue line for the request that has just finished, if one is installed and it has something to say.
+pub(crate) fn request_epilogue() -> Option<String> {
+    EPILOGUE.get().and_then(|line| line())
+}
+
+static TEXT_TAP: OnceLock<Box<dyn Fn(&str, &str) + Send + Sync>> = OnceLock::new();
+
+/// Install a tap on the streamed text: each chunk's reasoning and content deltas, as the client sees them.
+pub fn set_text_tap(tap: Box<dyn Fn(&str, &str) + Send + Sync>) {
+    let _ = TEXT_TAP.set(tap);
+}
+
+pub(crate) fn text_tap(reasoning: &str, content: &str) {
+    if let Some(tap) = TEXT_TAP.get() {
+        tap(reasoning, content);
+    }
+}
+
+/// The advertised ids, in the order `/v1/models` lists them.
+pub fn advertised_models() -> &'static [(String, Option<bool>)] {
+    ADVERTISED.get().map_or(&[], Vec::as_slice)
+}
+
+/// The generation mode an advertised id names; `None` when the id is not one, or names no mode (the request chooses).
+pub fn advertised_thinking(model: &str) -> Option<bool> {
+    advertised_models()
+        .iter()
+        .find(|(id, _)| id == model)
+        .and_then(|(_, thinking)| *thinking)
+}
+
+/// A request for a model id this server does not serve, answered before anything is parsed: OpenAI's 404 with its
+/// error object, and one console line naming the id asked for and the ids served. `None` when the id is served.
+pub(crate) fn refuse_unserved_model(requested: &str, state: &Arc<MistralRs>) -> Option<axum::response::Response> {
+    use axum::response::IntoResponse;
+    if validate_model_name(requested, state.clone()).is_ok() {
+        return None;
+    }
+    let served = std::iter::once("\"default\"".to_string())
+        .chain(advertised_models().iter().map(|(id, _)| format!("\"{id}\"")))
+        .collect::<Vec<_>>()
+        .join(", ");
+    tracing::warn!(
+        target: "oscar_runtime::serve",
+        "A model not served was requested: \"{requested}\"; ids served: {served}",
+    );
+    let body = serde_json::json!({
+        "error": {
+            "message": format!("The model '{requested}' is not served here; the ids served: {served}"),
+            "type": "invalid_request_error",
+            "param": "model",
+            "code": "model_not_found",
+        }
+    });
+    let mut response = axum::Json(body).into_response();
+    *response.status_mut() = axum::http::StatusCode::NOT_FOUND;
+    Some(response)
+}
