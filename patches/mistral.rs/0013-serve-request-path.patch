+/// A text message as a chat template reads it: the call arguments the wire carries as strings become maps, and a turn
+/// of calls alone has empty content, the template writing its calls from `tool_calls`.
+pub fn template_message(message: &Message) -> Result<IndexMap<String, Either<String, Vec<IndexMap<String, Value>>>>> {
+    let content = match message.content.as_deref() {
+        Some(Either::Left(content)) => content.clone(),
+        Some(Either::Right(_)) => anyhow::bail!("Expected a text message."),
+        None => {
+            message.tool_calls.as_ref().context("No content was provided, expected tool calls to be provided.")?;
+            String::new()
+        }
+    };
+    let fields = [
+        ("role", Some(&message.role)),
+        ("content", Some(&content)),
+        ("tool_call_id", message.tool_call_id.as_ref()),
+        ("name", message.name.as_ref()),
+        ("reasoning_content", message.reasoning_content.as_ref()),
+    ];
+    let mut map: IndexMap<_, _> =
+        fields.into_iter().filter_map(|(k, v)| Some((k.to_string(), Either::Left(v?.clone())))).collect();
+    if let Some(calls) = &message.tool_calls {
+        let calls = calls
+            .iter()
+            .map(|tc| {
+                let (name, arguments) = (&tc.function.name, &tc.function.arguments);
+                let arguments = serde_json::from_str(arguments).unwrap_or_else(|_| Value::String(arguments.clone()));
+                IndexMap::from([
+                    ("id".to_string(), Value::String(tc.id.clone().unwrap_or_else(|| name.clone()))),
+                    ("type".to_string(), Value::String("function".to_string())),
+                    ("function".to_string(), json!({"name": name, "arguments": arguments})),
+                ])
+            })
+            .collect();
+        map.insert("tool_calls".to_string(), Either::Right(calls));
+    }
+    Ok(map)
+}
